---
import "@fontsource/chakra-petch/600.css";
import "@fontsource/chakra-petch/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import { LANGS, DIR, LANG_NAME, ui, path, LINKS } from "../content/site.js";

interface Props { lang: string; route?: string; title: string; description: string; noindex?: boolean; }
const { lang, route = "/", title, description, noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = site + path(lang, route);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p) => base + p;
const ogLocale = { en: "en_US", de: "de_DE", ar: "ar" }[lang];
const home = href(path(lang, "/"));
---
<!doctype html>
<html lang={lang} dir={DIR[lang]} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={site + path(l, route)} />)}
  <link rel="alternate" hreflang="x-default" href={site + path("en", route)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#0a0e12" />
  <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  <script is:inline>
    document.documentElement.classList.add("js");
    try { const s = localStorage.getItem("theme"); if (s === "light" || s === "dark") document.documentElement.dataset.theme = s; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site no-print">
    <div class="wrap bar">
      <a class="logo" href={home} aria-label="Moutaz Mohammad">
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="name">moutaz<span>m</span></span>
      </a>
      <nav class="links" aria-label="Main">
        <a href={home + "#about"}>{t.nav.about}</a>
        <a href={home + "#projects"}>{t.nav.projects}</a>
        <a href={home + "#experience"}>{t.nav.work}</a>
        <a href={home + "#contact"}>{t.nav.contact}</a>
        <a class="cv" href={href(path(lang, "/cv"))}>{t.nav.cv}</a>
      </nav>
      <div class="tools">
        <div class="langs" role="group" aria-label={t.langSwitch}>
          {LANGS.map((l) => (
            <a href={href(path(l, route))} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAME[l]}</a>
          ))}
        </div>
        <button class="theme" type="button" aria-label={t.theme} title={t.theme}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site no-print">
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} Moutaz Mohammad</span>
      <span class="label">{t.footer.built}</span>
      <span class="flinks">
        <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
        <a href={href(path(lang, "/impressum"))}>{t.footer.imprint}</a>
        <a href={href(path(lang, "/privacy"))}>{t.footer.privacy}</a>
      </span>
    </div>
  </footer>

  <script>
    // theme toggle
    const btn = document.querySelector(".theme");
    btn?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch (e) {}
    });
    // reveal on scroll
    const els = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
    } else els.forEach((el) => el.classList.add("in"));
  </script>
</body>
</html>

<style>
  header.site {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 64px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 18px var(--f-mono); letter-spacing: .02em; }
  .logo .name span { color: var(--accent); }
  .mark { display: flex; gap: 3px; align-items: flex-end; height: 18px; }
  .mark i { width: 4px; background: var(--accent); border-radius: 1px; }
  .mark i:nth-child(1) { height: 18px; } .mark i:nth-child(2) { height: 8px; opacity: .55; } .mark i:nth-child(3) { height: 14px; background: var(--ai); }
  .links { display: flex; gap: 22px; margin-inline-start: auto; font-size: 14.5px; }
  .links a { text-decoration: none; color: var(--muted); transition: color .2s; }
  .links a:hover, .links a.cv { color: var(--fg); }
  .links a.cv { border: 1px solid var(--line); border-radius: 6px; padding: 3px 10px; }
  .tools { display: flex; align-items: center; gap: 10px; }
  .langs { display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .langs a { font: 600 12px var(--f-mono); padding: 6px 9px; text-decoration: none; color: var(--muted); }
  .langs a[lang="ar"] { font-family: "IBM Plex Sans Arabic", sans-serif; font-size: 13px; padding-block: 4px; }
  .langs a[aria-current] { background: var(--accent); color: var(--accent-ink); }
  .theme { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 6px; border: 1px solid var(--line); background: none; color: var(--muted); cursor: pointer; }
  .theme:hover { color: var(--fg); }
  .theme svg { width: 18px; height: 18px; }
  @media (max-width: 860px) { .links { display: none; } .tools { margin-inline-start: auto; } }

  footer.site { border-top: 1px solid var(--line); padding-block: 28px 40px; color: var(--muted); font-size: 14px; }
  .foot { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; justify-content: space-between; }
  .flinks { display: flex; gap: 18px; flex-wrap: wrap; }
  .flinks a { text-decoration: none; } .flinks a:hover { color: var(--fg); }
</style>
