const u = UI[lang] || UI.en;
const spec = (DATA[slug] && (DATA[slug][lang] || DATA[slug].en)) || null;
const uid = `aiv-${slug}`;
---

{spec && (
  <section class="aiv" id={uid} data-spec={JSON.stringify(spec)}>
    <div class="aiv-top">
      <div>
        <span class="label">{u.eyebrow}</span>
        <p class="aiv-sub">{u.subtitle}</p>
      </div>
      <button type="button" class="aiv-replay mono" data-replay>↻ {u.replay}</button>
    </div>

    <div class="aiv-tabs" role="tablist">
      {spec.scenarios.map((sc, idx) => (
        <button
          type="button"
          role="tab"
          class:list={["aiv-tab", { active: idx === 0 }]}
          aria-selected={idx === 0 ? "true" : "false"}
          data-sc={idx}
        >
          <span class:list={["dot", sc.tone]}></span>
          <span>{sc.label}</span>
        </button>
      ))}
    </div>

    <div class="aiv-stage">
      <ol class="aiv-nodes" role="list">
        {spec.nodes.map((nd, idx) => (
          <li class="aiv-node" data-node={idx}>
            <span class="aiv-code mono">{nd.code}</span>
            <strong class="aiv-ntitle">{nd.title}</strong>
            <span class="aiv-nsub">{nd.sub}</span>
            {idx < spec.nodes.length - 1 && (
              <span class="aiv-wire" aria-hidden="true"><i></i></span>
            )}
          </li>
        ))}
      </ol>

      <div class="aiv-console">
        <div class="aiv-chead">
          <span class="mono aiv-step-tag">{u.stepLabel}: <b data-step-num>01 / 05</b></span>
          <span class="aiv-badge mono" data-badge>{spec.scenarios[0].badge}</span>
        </div>
        <p class="aiv-msg" data-msg>{spec.scenarios[0].steps[0].msg}</p>
        <div class="aiv-telemetry mono">
          <span>{u.latency}: <b data-lat>{spec.scenarios[0].latency}</b></span>
          <span>{u.cost}: <b data-cost>{spec.scenarios[0].cost}</b></span>
          <span>{u.guard}: <b data-guard>{spec.scenarios[0].guard}</b></span>
        </div>
      </div>
    </div>

    <div class="aiv-impact">
      <h2 class="label">{u.impactTitle}</h2>
      <div class="aiv-metrics">
        {spec.metrics.map((m) => (
          <div class="aiv-metric">
            <strong class="aiv-mval">{m.val}</strong>
            <span class="aiv-mlbl">{m.lbl}</span>
          </div>
        ))}
      </div>
      <div class="aiv-cols">
        <div class="aiv-card">
          <h3>{u.lifeHead}</h3>
          <ul>
            {spec.lifeImpact.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="aiv-card">
          <h3>{u.projHead}</h3>
          <ul>
            {spec.projImpact.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>(".aiv").forEach((root) => {
    const raw = root.dataset.spec;
    if (!raw) return;
    const spec = JSON.parse(raw);
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sc]"));
    const nodes = Array.from(root.querySelectorAll<HTMLElement>("[data-node]"));
    const msgEl = root.querySelector<HTMLElement>("[data-msg]");
    const badgeEl = root.querySelector<HTMLElement>("[data-badge]");
    const stepEl = root.querySelector<HTMLElement>("[data-step-num]");
    const latEl = root.querySelector<HTMLElement>("[data-lat]");
    const costEl = root.querySelector<HTMLElement>("[data-cost]");
    const guardEl = root.querySelector<HTMLElement>("[data-guard]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-replay]");

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let curScenario = 0;
    let timer: number | undefined;

    function renderStep(scIdx: number, stIdx: number) {
      const sc = spec.scenarios[scIdx];
      const st = sc.steps[stIdx];
      nodes.forEach((n, i) => {
        n.classList.toggle("is-active", i === st.idx);
        n.classList.toggle("is-done", i < st.idx);
        n.dataset.tone = sc.tone;
      });
      if (msgEl) msgEl.textContent = st.msg;
      if (stepEl) stepEl.textContent = `${String(stIdx + 1).padStart(2, "0")} / ${String(sc.steps.length).padStart(2, "0")}`;
      if (badgeEl) {
        badgeEl.textContent = sc.badge;
        badgeEl.dataset.tone = sc.tone;
      }
      if (latEl) latEl.textContent = sc.latency;
      if (costEl) costEl.textContent = sc.cost;
      if (guardEl) guardEl.textContent = sc.guard;
    }

    function playScenario(scIdx: number) {
      curScenario = scIdx;
      if (timer) window.clearInterval(timer);
      tabs.forEach((t, i) => {
        t.classList.toggle("active", i === scIdx);
        t.setAttribute("aria-selected", i === scIdx ? "true" : "false");
      });
      const sc = spec.scenarios[scIdx];
      if (reduced) {
        renderStep(scIdx, sc.steps.length - 1);
        return;
      }
      let step = 0;
      renderStep(scIdx, step);
      timer = window.setInterval(() => {
        step += 1;
        if (step >= sc.steps.length) {
          window.clearInterval(timer);
          return;
        }
        renderStep(scIdx, step);
      }, 1700);
    }

    tabs.forEach((t, i) => t.addEventListener("click", () => playScenario(i)));
    replayBtn?.addEventListener("click", () => playScenario(curScenario));
    nodes.forEach((n, i) => {
      n.style.cursor = "pointer";
      n.addEventListener("click", () => {
        if (timer) window.clearInterval(timer);
        renderStep(curScenario, Math.min(i, spec.scenarios[curScenario].steps.length - 1));
      });
    });

    playScenario(0);
  });
</script>

