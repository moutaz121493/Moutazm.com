const u = UI[lang] || UI.en;
const spec = (DATA[slug] && (DATA[slug][lang] || DATA[slug].en)) || null;
const uid = `aiv3d-${slug}`;
---

{spec && (
  <section class="aiv3d" id={uid} data-spec={JSON.stringify(spec)} data-play={u.play} data-pause={u.pause}>
    <header class="aiv3d-head">
      <div class="aiv3d-title">
        <span class="label">{u.eyebrow}</span>
        <p class="aiv3d-sub">{u.subtitle}</p>
      </div>
      <div class="aiv3d-tabs" role="tablist">
        {spec.scenarios.map((sc, idx) => (
          <button
            type="button"
            role="tab"
            class:list={["aiv3d-tab", { active: idx === 0 }]}
            aria-selected={idx === 0 ? "true" : "false"}
            data-sc={idx}
          >
            <span class:list={["dot", sc.tone]}></span>
            <span>{sc.label}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="aiv3d-studio">
      <div class="aiv3d-left">
        <div class="aiv3d-viewport">
          <canvas class="aiv3d-canvas" data-canvas></canvas>
          <div class="aiv3d-hud-top mono">
            <span class="aiv3d-hint">{u.dragHint}</span>
            <span class="aiv3d-badge" data-badge>{spec.scenarios[0].badge}</span>
          </div>
          <div class="aiv3d-hud-bot mono">
            <div class="aiv3d-cam-bar">
              <button type="button" class="cam-btn active" data-cam="iso">{u.camIso}</button>
              <button type="button" class="cam-btn" data-cam="top">{u.camTop}</button>
              <button type="button" class="cam-btn" data-cam="front">{u.camFront}</button>
            </div>
            <button type="button" class="ctrl-btn" data-toggle>{u.pause}</button>
          </div>
        </div>

        <div class="aiv3d-telemetry mono">
          <div class="tel-item"><span>{u.latency}</span><b data-lat>{spec.scenarios[0].latency}</b></div>
          <div class="tel-item"><span>{u.cost}</span><b data-cost>{spec.scenarios[0].cost}</b></div>
          <div class="tel-item"><span>{u.guard}</span><b data-guard>{spec.scenarios[0].guard}</b></div>
        </div>
        <p class="aiv3d-telnote">{u.telNote}</p>
      </div>

      <div class="aiv3d-right">
        <div class="aiv3d-step-head mono">
          <span>{u.stageTag} <b data-step-num>01 / 05</b></span>
          <span data-node-name>{spec.nodes[0].code} · {spec.nodes[0].title}</span>
        </div>

        <ol class="aiv3d-timeline" role="list">
          {spec.scenarios[0].steps.map((st, idx) => (
            <li class:list={["tstep", { active: idx === 0 }]} data-step-card={idx}>
              <div class="tstep-row">
                <span class="tstep-num mono">{spec.nodes[idx].code}</span>
                <strong class="tstep-title" data-st-head={idx}>{st.headline}</strong>
                <span class="tstep-mod mono">{spec.nodes[idx].title}</span>
              </div>
              <div class="tstep-body">
                <p class="tstep-msg" data-st-msg={idx}>{st.msg}</p>
                <div class="tstep-why">
                  <span class="mono">{u.whyHead}:</span> <span data-st-why={idx}>{st.why}</span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="aiv3d-impact">
      <h2 class="label">{u.impactTitle}</h2>
      <div class="aiv3d-metrics">
        {spec.metrics.map((m) => (
          <div class="aiv3d-metric">
            <strong class="aiv3d-mval">{m.val}</strong>
            <span class="aiv3d-mlbl">{m.lbl}</span>
          </div>
        ))}
      </div>
      <div class="aiv3d-cols">
        <div class="aiv3d-card">
          <h3>{u.lifeHead}</h3>
          <ul>
            {spec.lifeImpact.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="aiv3d-card">
          <h3>{u.projHead}</h3>
          <ul>
            {spec.projImpact.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  // three.js loads only when a 3D system view comes near the screen
  const roots = document.querySelectorAll(".aiv3d");
  if (roots.length) {
    const go = () => import("../scripts/aiv3d.ts");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: "600px 0px" });
      roots.forEach((r) => io.observe(r));
    } else go();
  }
</script>

