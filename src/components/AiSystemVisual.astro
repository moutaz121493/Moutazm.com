<script>
  import * as THREE from "three";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";
  import { OutputPass } from "three/examples/jsm/postprocessing/OutputPass.js";

  document.querySelectorAll<HTMLElement>(".aiv3d").forEach((root) => {
    const raw = root.dataset.spec;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]");
    if (!raw || !canvas) return;
    const spec = JSON.parse(raw);

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sc]"));
    const camBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cam]"));
    const nodeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-node-btn]"));
    const msgEl = root.querySelector<HTMLElement>("[data-msg]");
    const headlineEl = root.querySelector<HTMLElement>("[data-headline]");
    const whyEl = root.querySelector<HTMLElement>("[data-why]");
    const nodeNameEl = root.querySelector<HTMLElement>("[data-node-name]");
    const badgeEl = root.querySelector<HTMLElement>("[data-badge]");
    const stepEl = root.querySelector<HTMLElement>("[data-step-num]");
    const latEl = root.querySelector<HTMLElement>("[data-lat]");
    const costEl = root.querySelector<HTMLElement>("[data-cost]");
    const guardEl = root.querySelector<HTMLElement>("[data-guard]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]");
    const toggleBtn = root.querySelector<HTMLButtonElement>("[data-toggle]");

    const playTxt = root.dataset.play || "Auto-Play";
    const pauseTxt = root.dataset.pause || "Pause";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let curScenario = 0;
    let curStep = 0;
    let autoPlay = !reduced;
    let stepTimer = 0;

    // --- Three.js 3D Floorplan Setup ---
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, 16 / 9, 0.1, 100);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloom = new UnrealBloomPass(new THREE.Vector2(720, 420), 0.65, 0.42, 0.22);
    composer.addPass(bloom);
    composer.addPass(new OutputPass());

    const camTargets = {
      iso: { theta: 0.58, phi: 0.78, dist: 14.5 },
      top: { theta: 0.02, phi: 0.24, dist: 15.2 },
      front: { theta: 0.22, phi: 1.08, dist: 13.0 },
    };
    let targetCam = { ...camTargets.iso };
    let currentCam = { ...camTargets.iso };

    const ambient = new THREE.AmbientLight(0xffffff, 0.75);
    scene.add(ambient);
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.15);
    dirLight.position.set(8, 14, 9);
    scene.add(dirLight);
    const rimLight = new THREE.PointLight(0x4fd1ff, 1.4, 28);
    rimLight.position.set(-7, 6, -5);
    scene.add(rimLight);

    // Architectural floorplan base + grid
    const floorGroup = new THREE.Group();
    scene.add(floorGroup);

    const baseGeo = new THREE.BoxGeometry(15.2, 0.18, 7.6);
    const baseMat = new THREE.MeshStandardMaterial({ color: 0x0e1722, roughness: 0.85, metalness: 0.15 });
    const baseMesh = new THREE.Mesh(baseGeo, baseMat);
    baseMesh.position.y = -0.1;
    floorGroup.add(baseMesh);

    const grid = new THREE.GridHelper(15, 15, 0x2a455f, 0x1a2c3d);
    grid.scale.set(1, 1, 0.5);
    grid.position.y = 0.01;
    floorGroup.add(grid);

    // 5 3D Floorplan Nodes laid out in a spacious staggered architectural flow
    const positions = [
      new THREE.Vector3(-5.6, 0, 1.1),
      new THREE.Vector3(-2.8, 0, -1.1),
      new THREE.Vector3(0.0, 0, 0.9),
      new THREE.Vector3(2.8, 0, -1.1),
      new THREE.Vector3(5.6, 0, 1.1),
    ];

    const kindColors: Record<string, number> = {
      in: 0x45e08f,
      sec: 0xf5b83f,
      core: 0x4fd1ff,
      ai: 0xa78bfa,
      out: 0x45e08f,
    };

    const nodeMeshes: {
      group: THREE.Group;
      box: THREE.Mesh;
      mat: THREE.MeshStandardMaterial;
      ring: THREE.Mesh;
      ringMat: THREE.MeshBasicMaterial;
      baseY: number;
      color: number;
      idx: number;
    }[] = [];

    spec.nodes.forEach((nd: any, idx: number) => {
      const col = kindColors[nd.kind] || 0x4fd1ff;
      const g = new THREE.Group();
      const pos = positions[idx];
      g.position.set(pos.x, 0, pos.z);

      // Floor pad
      const pad = new THREE.Mesh(
        new THREE.BoxGeometry(2.05, 0.08, 2.05),
        new THREE.MeshStandardMaterial({ color: 0x152333, roughness: 0.6, metalness: 0.3 })
      );
      pad.position.y = 0.04;
      g.add(pad);

      // Extruded 3D architectural module block
      const h = nd.h || 1.4;
      const mat = new THREE.MeshStandardMaterial({
        color: 0x18283a,
        emissive: col,
        emissiveIntensity: 0.14,
        roughness: 0.32,
        metalness: 0.45,
      });
      const box = new THREE.Mesh(new THREE.BoxGeometry(1.55, h, 1.55), mat);
      box.position.y = h / 2 + 0.12;
      box.userData.nodeIdx = idx;
      g.add(box);

      // Glowing wireframe edges on the 3D block
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.BoxGeometry(1.57, h + 0.02, 1.57)),
        new THREE.LineBasicMaterial({ color: col, transparent: true, opacity: 0.72 })
      );
      edges.position.copy(box.position);
      g.add(edges);

      // Floating orbital beacon ring above each module
      const ringMat = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.28, side: THREE.DoubleSide });
      const ring = new THREE.Mesh(new THREE.RingGeometry(0.62, 0.74, 32), ringMat);
      ring.rotation.x = -Math.PI / 2;
      ring.position.y = h + 0.42;
      g.add(ring);

      scene.add(g);
      nodeMeshes.push({ group: g, box, mat, ring, ringMat, baseY: h / 2 + 0.12, color: col, idx });
    });

    // Curved 3D signal pipes connecting consecutive modules
    const curves: THREE.CatmullRomCurve3[] = [];
    for (let i = 0; i < positions.length - 1; i++) {
      const a = positions[i].clone().setY(0.45);
      const b = positions[i + 1].clone().setY(0.45);
      const mid = a.clone().lerp(b, 0.5);
      mid.y = 1.05;
      const curve = new THREE.CatmullRomCurve3([a, mid, b]);
      curves.push(curve);
      const tube = new THREE.Mesh(
        new THREE.TubeGeometry(curve, 24, 0.045, 8, false),
        new THREE.MeshBasicMaterial({ color: 0x3b607e, transparent: true, opacity: 0.55 })
      );
      scene.add(tube);
    }

    // Glowing animated 3D data packets riding along the pipes
    const packets: { mesh: THREE.Mesh; seg: number; t: number; speed: number }[] = [];
    const pktGeo = new THREE.SphereGeometry(0.16, 16, 16);
    for (let i = 0; i < curves.length; i++) {
      for (let k = 0; k < 2; k++) {
        const mesh = new THREE.Mesh(pktGeo, new THREE.MeshBasicMaterial({ color: 0x45e08f }));
        scene.add(mesh);
        packets.push({ mesh, seg: i, t: k * 0.5, speed: 0.45 });
      }
    }

    // Ambient floating particles for depth
    const partCount = 48;
    const partPos = new Float32Array(partCount * 3);
    for (let i = 0; i < partCount; i++) {
      partPos[i * 3] = (Math.random() - 0.5) * 16;
      partPos[i * 3 + 1] = 0.6 + Math.random() * 4.5;
      partPos[i * 3 + 2] = (Math.random() - 0.5) * 8;
    }
    const partGeo = new THREE.BufferGeometry();
    partGeo.setAttribute("position", new THREE.BufferAttribute(partPos, 3));
    const partMat = new THREE.PointsMaterial({ color: 0x4fd1ff, size: 0.08, transparent: true, opacity: 0.45 });
    const particles = new THREE.Points(partGeo, partMat);
    scene.add(particles);

    // Sync colors with HUD dark / Retro-Tech light theme
    function syncTheme() {
      const light = document.documentElement.dataset.theme === "light";
      baseMat.color.setHex(light ? 0xe7ecf2 : 0x0e1722);
      nodeMeshes.forEach((n) => n.mat.color.setHex(light ? 0xdbe3ec : 0x18283a));
      bloom.strength = light ? 0.16 : 0.68;
    }
    syncTheme();
    new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    // Drag-to-orbit + click-to-inspect 3D raycasting
    let dragging = false;
    let moved = false;
    let lastX = 0;
    let lastY = 0;
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();

    canvas.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = false;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
      targetCam.theta -= dx * 0.0065;
      targetCam.phi = Math.max(0.22, Math.min(1.28, targetCam.phi - dy * 0.005));
      lastX = e.clientX;
      lastY = e.clientY;
    });
    canvas.addEventListener("pointerup", (e) => {
      dragging = false;
      if (!moved) {
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(nodeMeshes.map((n) => n.box));
        if (hits.length > 0) {
          const idx = hits[0].object.userData.nodeIdx;
          autoPlay = false;
          updateToggleLabel();
          renderStep(curScenario, idx);
        }
      }
    });

    function resize() {
      const w = canvas.clientWidth || 720;
      const h = canvas.clientHeight || 420;
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
      bloom.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    new ResizeObserver(resize).observe(canvas);

    // --- UI State & Controls ---
    function updateToggleLabel() {
      if (toggleBtn) toggleBtn.textContent = autoPlay ? pauseTxt : playTxt;
    }

    function renderStep(scIdx: number, stIdx: number) {
      curScenario = scIdx;
      curStep = stIdx;
      const sc = spec.scenarios[scIdx];
      const st = sc.steps[stIdx];
      const nd = spec.nodes[st.idx];

      tabs.forEach((t, i) => {
        t.classList.toggle("active", i === scIdx);
        t.setAttribute("aria-selected", i === scIdx ? "true" : "false");
      });
      nodeBtns.forEach((b, i) => {
        b.classList.toggle("active", i === st.idx);
        b.classList.toggle("done", i < st.idx);
      });

      if (stepEl) stepEl.textContent = `${String(stIdx + 1).padStart(2, "0")} / ${String(sc.steps.length).padStart(2, "0")}`;
      if (nodeNameEl && nd) nodeNameEl.textContent = `${nd.code} · ${nd.title}`;
      if (headlineEl) headlineEl.textContent = st.headline;
      if (msgEl) msgEl.textContent = st.msg;
      if (whyEl) whyEl.textContent = st.why;
      if (badgeEl) {
        badgeEl.textContent = sc.badge;
        badgeEl.dataset.tone = sc.tone;
      }
      if (latEl) latEl.textContent = sc.latency;
      if (costEl) costEl.textContent = sc.cost;
      if (guardEl) guardEl.textContent = sc.guard;

      const toneHex = sc.tone === "accent" ? 0xf5b83f : sc.tone === "ai" ? 0xa78bfa : 0x45e08f;
      packets.forEach((p) => (p.mesh.material as THREE.MeshBasicMaterial).color.setHex(toneHex));
    }

    tabs.forEach((t, i) => t.addEventListener("click", () => { stepTimer = 0; renderStep(i, 0); }));
    nodeBtns.forEach((b, i) => b.addEventListener("click", () => { autoPlay = false; updateToggleLabel(); renderStep(curScenario, i); }));
    camBtns.forEach((b) => {
      b.addEventListener("click", () => {
        const key = b.dataset.cam as keyof typeof camTargets;
        if (!camTargets[key]) return;
        targetCam = { ...camTargets[key] };
        camBtns.forEach((c) => c.classList.toggle("active", c === b));
      });
    });
    prevBtn?.addEventListener("click", () => {
      autoPlay = false;
      updateToggleLabel();
      const len = spec.scenarios[curScenario].steps.length;
      renderStep(curScenario, (curStep - 1 + len) % len);
    });
    nextBtn?.addEventListener("click", () => {
      autoPlay = false;
      updateToggleLabel();
      const len = spec.scenarios[curScenario].steps.length;
      renderStep(curScenario, (curStep + 1) % len);
    });
    toggleBtn?.addEventListener("click", () => {
      autoPlay = !autoPlay;
      stepTimer = 0;
      updateToggleLabel();
    });

    updateToggleLabel();
    renderStep(0, 0);

    // --- Animation Loop (pauses when off-screen) ---
    let visible = true;
    new IntersectionObserver((entries) => { visible = entries[0]?.isIntersecting ?? true; }, { threshold: 0.05 }).observe(root);

    let lastTime = performance.now();
    function tick(now: number) {
      requestAnimationFrame(tick);
      if (!visible) { lastTime = now; return; }
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      // Auto-advance walkthrough every 3.4s
      if (autoPlay) {
        stepTimer += dt;
        if (stepTimer >= 3.4) {
          stepTimer = 0;
          const len = spec.scenarios[curScenario].steps.length;
          renderStep(curScenario, (curStep + 1) % len);
        }
      }

      // Smooth camera interpolation + gentle ambient sway
      const sway = reduced || dragging ? 0 : Math.sin(now * 0.00035) * 0.08;
      currentCam.theta += (targetCam.theta + sway - currentCam.theta) * 0.08;
      currentCam.phi += (targetCam.phi - currentCam.phi) * 0.08;
      currentCam.dist += (targetCam.dist - currentCam.dist) * 0.08;

      camera.position.set(
        Math.sin(currentCam.theta) * Math.sin(currentCam.phi) * currentCam.dist,
        Math.cos(currentCam.phi) * currentCam.dist,
        Math.cos(currentCam.theta) * Math.sin(currentCam.phi) * currentCam.dist
      );
      camera.lookAt(0, 0.65, 0);

      // Animate 3D stage modules (active floats & glows)
      const activeIdx = spec.scenarios[curScenario].steps[curStep].idx;
      nodeMeshes.forEach((n, i) => {
        const isActive = i === activeIdx;
        const isDone = i < activeIdx;
        const lift = isActive ? 0.28 + Math.sin(now * 0.004) * 0.08 : 0;
        n.box.position.y += (n.baseY + lift - n.box.position.y) * 0.12;
        n.mat.emissiveIntensity += ((isActive ? 0.62 : isDone ? 0.25 : 0.08) - n.mat.emissiveIntensity) * 0.1;
        n.ring.rotation.z += dt * (isActive ? 1.8 : 0.35);
        n.ring.scale.setScalar(isActive ? 1.18 + Math.sin(now * 0.006) * 0.08 : 0.92);
        n.ringMat.opacity = isActive ? 0.9 : isDone ? 0.42 : 0.18;
      });

      // Animate 3D energy packets flowing along curved pipes
      packets.forEach((p) => {
        p.t = (p.t + dt * p.speed) % 1;
        const pt = curves[p.seg].getPoint(p.t);
        p.mesh.position.copy(pt);
        const activePipe = p.seg <= activeIdx;
        p.mesh.visible = activePipe;
      });

      particles.rotation.y += dt * 0.04;
      composer.render();
    }
    requestAnimationFrame(tick);
  });
</script>

