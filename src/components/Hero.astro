---
import Illo from "./Illo.astro";
import { ui, path } from "../content/site.js";
const { lang } = Astro.props;
const t = ui[lang].hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const full3dLabel = lang === "de" ? "3D-Bühne öffnen ↗" : lang === "ar" ? "افتح العرض 3D ↗" : "Full 3D Stage ↗";
const cta3dLabel = lang === "de" ? "3D-Architektur" : lang === "ar" ? "استكشف 3D" : "Explore 3D";
---
<section class="hero">
  <div class="wrap bento grid">
    <div class="tile copy" data-notilt>
      <p class="label kicker"><span class="led" aria-hidden="true"></span>{t.kicker}</p>
      <h1>
        <span class="name">Moutaz Mohammad</span>
        <span class="title">{t.title}</span>
        <span class="line">{t.line}</span>
      </h1>
      <ul class="keys" aria-label="Focus">
        {t.keys.map((k, i) => <li><span class="mono">0{i + 1}</span>{k}</li>)}
      </ul>
      <div class="ctas">
        <a class="btn primary" href={base + path(lang, "/3d")}>
          <span>{cta3dLabel}</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn" href={base + path(lang, "/cv")}>{t.cta.cv}</a>
        <a class="btn" href="#projects">{t.cta.projects}</a>
        <a class="btn" href="#contact">{t.cta.contact}</a>
      </div>
    </div>

    <div class="tile viz" data-notilt>
      <canvas id="hero3d-core" aria-hidden="true"></canvas>
      <a class="viz-open mono" href={base + path(lang, "/3d")}>{full3dLabel}</a>
      <div class="legend mono" aria-hidden="true">
        <span><i class="h"></i>M_CAN SILICON</span><span><i class="n"></i>NEURAL GIMBAL</span><span class="brs">60 FPS</span>
      </div>
    </div>

    <figure class="polaroid hero-photo">
      <div class="shot"><Illo name="lab" /></div>
      <figcaption class="mono">{t.lab}</figcaption>
    </figure>
    <div class="tile clock">
      <span class="label"><span class="led ai" aria-hidden="true"></span>{t.local}</span>
      <span class="time mono" data-clock>--:--:--</span>
      <span class="zone mono">{t.kicker}</span>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";
  import { OutputPass } from "three/examples/jsm/postprocessing/OutputPass.js";

  const cv = document.getElementById("hero3d-core") as HTMLCanvasElement | null;
  if (cv) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let renderer: THREE.WebGLRenderer | null = null;
    try {
      renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true, powerPreference: "high-performance" });
    } catch {
      renderer = null;
    }

    if (renderer) {
      renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.02;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1.5, 0.1, 60);
      camera.position.set(0, 1.4, 6.8);
      camera.lookAt(0, 0, 0);

      // Selective high-threshold bloom: crisp dark anodized metal, zero whiteout!
      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      const bloom = new UnrealBloomPass(new THREE.Vector2(400, 300), 0.28, 0.35, 0.86);
      composer.addPass(bloom);
      composer.addPass(new OutputPass());

      scene.add(new THREE.HemisphereLight(0xdbeafe, 0x090f16, 0.9));
      const key = new THREE.DirectionalLight(0xffffff, 1.8);
      key.position.set(5, 8, 6);
      scene.add(key);
      const rimGold = new THREE.PointLight(0xf5b83f, 2.2, 14);
      rimGold.position.set(-4, 2.5, 3);
      scene.add(rimGold);
      const rimCyan = new THREE.PointLight(0x4fd1ff, 2.4, 14);
      rimCyan.position.set(4, -1.5, 3.5);
      scene.add(rimCyan);

      const rig = new THREE.Group();
      rig.rotation.x = 0.22;
      scene.add(rig);

      // Precision dark-titanium faceted core + crisp cyan wireframe edge cage
      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x13202e,
        emissive: 0x0c2d42,
        emissiveIntensity: 0.45,
        roughness: 0.24,
        metalness: 0.88,
        flatShading: true,
      });
      const core = new THREE.Mesh(new THREE.OctahedronGeometry(0.92, 1), coreMat);
      rig.add(core);

      const innerCoreMat = new THREE.MeshBasicMaterial({ color: 0x4fd1ff });
      const innerPulse = new THREE.Mesh(new THREE.OctahedronGeometry(0.38, 0), innerCoreMat);
      rig.add(innerPulse);

      const cageMat = new THREE.LineBasicMaterial({ color: 0x4fd1ff, transparent: true, opacity: 0.65 });
      const cage = new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.IcosahedronGeometry(1.26, 1)), cageMat);
      rig.add(cage);

      // Anodized silicon wafer base ring with precision gold pins
      const waferGroup = new THREE.Group();
      const waferRing = new THREE.Mesh(
        new THREE.CylinderGeometry(2.15, 2.25, 0.08, 48, 1, true),
        new THREE.MeshStandardMaterial({ color: 0x182635, roughness: 0.35, metalness: 0.8, side: THREE.DoubleSide })
      );
      waferGroup.add(waferRing);
      const pinGeo = new THREE.BoxGeometry(0.05, 0.04, 0.22);
      const pinMat = new THREE.MeshStandardMaterial({ color: 0xf5b83f, emissive: 0xf5b83f, emissiveIntensity: 0.55, roughness: 0.25, metalness: 0.9 });
      for (let i = 0; i < 24; i++) {
        const a = (i / 24) * Math.PI * 2;
        const p = new THREE.Mesh(pinGeo, pinMat);
        p.position.set(Math.cos(a) * 2.2, 0, Math.sin(a) * 2.2);
        p.rotation.y = -a;
        waferGroup.add(p);
      }
      waferGroup.rotation.x = 0.15;
      rig.add(waferGroup);

      // Three ultra-crisp machined gimbal rings
      const r1Mat = new THREE.MeshStandardMaterial({ color: 0xf5b83f, emissive: 0xf5b83f, emissiveIntensity: 0.85, roughness: 0.2, metalness: 0.85 });
      const r2Mat = new THREE.MeshStandardMaterial({ color: 0x4fd1ff, emissive: 0x4fd1ff, emissiveIntensity: 0.85, roughness: 0.2, metalness: 0.85 });
      const r3Mat = new THREE.MeshStandardMaterial({ color: 0x45e08f, emissive: 0x45e08f, emissiveIntensity: 0.75, roughness: 0.2, metalness: 0.85 });

      const ring1 = new THREE.Mesh(new THREE.TorusGeometry(1.68, 0.022, 16, 96), r1Mat);
      const ring2 = new THREE.Mesh(new THREE.TorusGeometry(1.96, 0.018, 16, 96), r2Mat);
      const ring3 = new THREE.Mesh(new THREE.TorusGeometry(2.42, 0.014, 12, 96), r3Mat);
      ring1.rotation.set(Math.PI * 0.36, 0.2, 0);
      ring2.rotation.set(-Math.PI * 0.3, 0.55, 0.35);
      ring3.rotation.set(Math.PI * 0.48, -0.35, 0.2);
      rig.add(ring1, ring2, ring3);

      // Orbiting telemetry nodes
      const orbNodes: { mesh: THREE.Mesh; radius: number; speed: number; phase: number; tilt: number }[] = [];
      const orbGeo = new THREE.SphereGeometry(0.065, 16, 12);
      for (let i = 0; i < 9; i++) {
        const mat = i % 3 === 0 ? r1Mat : i % 3 === 1 ? r2Mat : r3Mat;
        const m = new THREE.Mesh(orbGeo, mat);
        rig.add(m);
        orbNodes.push({
          mesh: m,
          radius: i % 3 === 0 ? 1.68 : i % 3 === 1 ? 1.96 : 2.42,
          speed: (i % 2 === 0 ? 1 : -1) * (0.6 + (i % 3) * 0.2),
          phase: (i / 9) * Math.PI * 2,
          tilt: i % 3 === 0 ? 0.6 : i % 3 === 1 ? -0.5 : 0.85,
        });
      }

      const syncTheme = () => {
        const light = document.documentElement.dataset.theme === "light";
        const css = (n: string, f: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f;
        const acc = new THREE.Color(css("--hex-accent", "#f7bd4a"));
        const ai = new THREE.Color(css("--hex-ai", "#5ad4ff"));
        const live = new THREE.Color(css("--hex-live", "#4ae39a"));
        coreMat.color.setHex(light ? 0xd9cdb4 : 0x13202e);
        r1Mat.color.copy(acc); r1Mat.emissive.copy(acc);
        pinMat.color.copy(acc); pinMat.emissive.copy(acc);
        r2Mat.color.copy(ai); r2Mat.emissive.copy(ai);
        r3Mat.color.copy(live); r3Mat.emissive.copy(live);
        innerCoreMat.color.copy(ai);
        cageMat.color.copy(ai);
        bloom.strength = light ? 0.12 : 0.28;
      };
      syncTheme();
      new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

      let tx = 0, ty = 0.22;
      const box = cv.parentElement!;
      box.addEventListener("pointermove", (e) => {
        const r = box.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 0.85;
        ty = 0.22 + ((e.clientY - r.top) / r.height - 0.5) * 0.55;
      });
      box.addEventListener("pointerleave", () => { tx = 0; ty = 0.22; });

      const resize = () => {
        const r = box.getBoundingClientRect();
        const w = Math.max(240, r.width);
        const h = Math.max(220, r.height);
        renderer!.setSize(w, h, false);
        composer.setSize(w, h);
        bloom.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      new ResizeObserver(resize).observe(box);

      let visible = true;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.05 }).observe(box);

      let last = 0;
      const tick = (now: number) => {
        requestAnimationFrame(tick);
        if (!visible) { last = now; return; }
        const dt = last ? Math.max(0, Math.min((now - last) / 1000, 0.05)) : 0.016;
        last = now;

        rig.rotation.y += (tx - rig.rotation.y) * 0.06;
        rig.rotation.x += (ty - rig.rotation.x) * 0.06;

        if (!reduce) {
          core.rotation.y += dt * 0.42;
          cage.rotation.y -= dt * 0.28;
          waferGroup.rotation.y += dt * 0.18;
          ring1.rotation.z += dt * 0.55;
          ring2.rotation.z -= dt * 0.4;
          ring3.rotation.y += dt * 0.3;
          innerPulse.scale.setScalar(0.92 + Math.sin(now * 0.0035) * 0.12);

          const t = now * 0.001;
          orbNodes.forEach((o) => {
            const a = t * o.speed + o.phase;
            o.mesh.position.set(
              Math.cos(a) * o.radius,
              Math.sin(a) * o.radius * Math.cos(o.tilt),
              Math.sin(a) * o.radius * Math.sin(o.tilt)
            );
          });
        }
        composer.render();
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .hero { padding-block: clamp(24px, 5vw, 56px) clamp(48px, 7vw, 88px); position: relative; overflow-x: clip; }
  .hero::before {
    content: ""; position: absolute; inset: -14% -8% auto auto; width: 68%; height: 115%;
    background: radial-gradient(closest-side, var(--glow), transparent 70%); pointer-events: none;
  }
  .hero::after {
    content: ""; position: absolute; inset: auto auto -20% -10%; width: 55%; height: 95%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ai) 12%, transparent), transparent 72%); pointer-events: none;
  }
  .grid { position: relative; grid-template-rows: auto auto; align-items: stretch; }
  .copy { grid-column: 1 / 8; grid-row: 1 / 3; padding: clamp(28px, 3.6vw, 48px); display: flex; flex-direction: column; justify-content: center; }
  .viz {
    grid-column: 8 / 13; grid-row: 1; padding: 0; position: relative; min-height: 300px; overflow: hidden;
    background:
      radial-gradient(320px 220px at 50% 48%, color-mix(in srgb, var(--ai) 10%, transparent), transparent 75%),
      var(--card);
  }
  .hero-photo { grid-column: 8 / 11; grid-row: 2; }
  .clock { grid-column: 11 / 13; grid-row: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 18px; }
  .kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
  h1 { display: grid; gap: 14px; }
  .name { font-size: clamp(14px, 1.5vw, 16px); font-family: var(--f-mono); font-weight: 500; color: var(--accent); letter-spacing: .12em; text-transform: uppercase; }
  :root[lang="ar"] .name { font-family: var(--f-mono); }
  .title { font-size: clamp(36px, 5vw, 62px); font-weight: 700; letter-spacing: -.015em; line-height: 1.04;
    background: linear-gradient(115deg, var(--fg) 42%, var(--accent) 52%, var(--fg) 62%) 0 0 / 250% 100% text; color: transparent; background-position: 100% 0; animation: sheen 1.8s ease-in-out .5s both; }
  .copy:hover .title { animation: sheen2 1.4s ease-in-out both; }
  @keyframes sheen { from { background-position: 100% 0; } to { background-position: -50% 0; } }
  @keyframes sheen2 { from { background-position: 100% 0; } to { background-position: -50% 0; } }
  :root[lang="ar"] .title { line-height: 1.25; letter-spacing: 0; }
  .line { font-size: clamp(19px, 2.1vw, 25px); font-weight: 600; color: var(--muted); }
  .keys { list-style: none; padding: 0; margin: 28px 0 32px; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .keys li { display: flex; gap: 8px; align-items: baseline; font-weight: 600; }
  .keys .mono { color: var(--accent); font-size: 12px; }
  @media (max-width: 520px) { .keys { flex-direction: column; gap: 10px; } }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .ctas { display: grid; grid-template-columns: 1fr 1fr; } .ctas .btn { justify-content: center; } .ctas .primary { grid-column: 1 / -1; } }
  .viz canvas { width: 100%; height: 100%; position: absolute; inset: 0; }
  .viz-open {
    position: absolute; top: 12px; inset-inline-end: 12px; z-index: 2;
    font-size: 11px; text-decoration: none; color: var(--fg);
    padding: 5px 12px; border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--ai) 50%, var(--line));
    backdrop-filter: blur(8px);
    transition: border-color .2s, transform .2s;
  }
  .viz-open:hover { border-color: var(--accent); transform: translateY(-1px); }
  @media (pointer: coarse) { .viz-open { min-height: 40px; display: inline-flex; align-items: center; } }
  .legend { position: absolute; inset-inline-start: 14px; bottom: 10px; z-index: 2; display: flex; gap: 14px; font-size: 10.5px; color: var(--muted); flex-wrap: wrap; direction: ltr; pointer-events: none; letter-spacing: .06em; }
  .legend i { display: inline-block; width: 10px; height: 2px; vertical-align: middle; margin-inline-end: 6px; background: var(--accent); }
  .legend i.n { background: var(--ai); }
  .legend .brs { color: var(--live); }
  .clock .label { display: flex; align-items: center; gap: 8px; }
  .time { font-size: clamp(22px, 2.2vw, 28px); white-space: nowrap; font-weight: 500; color: var(--fg); letter-spacing: .02em; direction: ltr; text-align: start; }
  .zone { font-size: 11px; color: var(--muted); }
  :root[lang="ar"] .zone { font-family: var(--f-body); font-size: 13px; }
  .hero-photo { rotate: -2deg; }
  @media (max-width: 1080px) {
    .copy { grid-column: 1 / -1; grid-row: auto; }
    .viz { grid-column: 1 / 8; grid-row: auto; min-height: 280px; }
    .hero-photo { grid-column: 8 / 13; grid-row: auto; }
    .clock { grid-column: 1 / -1; grid-row: auto; flex-direction: row; align-items: center; }
  }
  @media (max-width: 680px) {
    .viz, .hero-photo { grid-column: 1 / -1; }
    .hero-photo { rotate: 0deg; }
  }
</style>
