---
import Illo from "./Illo.astro";
import { ui, path } from "../content/site.js";
const { lang } = Astro.props;
const t = ui[lang].hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const full3dLabel = lang === "de" ? "3D-Bühne öffnen ↗" : lang === "ar" ? "افتح العرض 3D ↗" : "Full 3D Stage ↗";
const cta3dLabel = lang === "de" ? "3D-Architektur" : lang === "ar" ? "استكشف 3D" : "Explore 3D";
---
<section class="hero">
  <div class="wrap bento grid">
    <div class="tile copy" data-notilt>
      <p class="label kicker"><span class="led" aria-hidden="true"></span>{t.kicker}</p>
      <h1>
        <span class="name">Moutaz Mohammad</span>
        <span class="title">{t.title}</span>
        <span class="line">{t.line}</span>
      </h1>
      <ul class="keys" aria-label="Focus">
        {t.keys.map((k, i) => <li><span class="mono">0{i + 1}</span>{k}</li>)}
      </ul>
      <div class="ctas">
        <a class="btn primary" href={base + path(lang, "/3d")}>
          <span>{cta3dLabel}</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn" href={base + path(lang, "/cv")}>{t.cta.cv}</a>
        <a class="btn" href="#projects">{t.cta.projects}</a>
        <a class="btn" href="#contact">{t.cta.contact}</a>
      </div>
    </div>

    <div class="tile viz" data-notilt>
      <canvas id="hero3d-core" aria-hidden="true"></canvas>
      <a class="viz-open mono" href={base + path(lang, "/3d")}>{full3dLabel}</a>
      <div class="legend mono" aria-hidden="true">
        <span><i class="h"></i>CAN FD</span><span><i class="n"></i>NEURAL CORE</span><span class="brs">LIVE 3D</span>
      </div>
    </div>

    <figure class="polaroid hero-photo">
      <div class="shot"><Illo name="lab" /></div>
      <figcaption class="mono">{t.lab}</figcaption>
    </figure>
    <div class="tile clock">
      <span class="label"><span class="led ai" aria-hidden="true"></span>{t.local}</span>
      <span class="time mono" data-clock>--:--:--</span>
      <span class="zone mono">{t.kicker}</span>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";
  import { OutputPass } from "three/examples/jsm/postprocessing/OutputPass.js";

  const cv = document.getElementById("hero3d-core") as HTMLCanvasElement | null;
  if (cv) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let renderer: THREE.WebGLRenderer | null = null;
    try {
      renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true, powerPreference: "high-performance" });
    } catch {
      renderer = null;
    }

    if (renderer) {
      renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.18;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1.5, 0.1, 60);
      camera.position.set(0, 0.4, 6.2);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      const bloom = new UnrealBloomPass(new THREE.Vector2(400, 300), 0.72, 0.45, 0.2);
      composer.addPass(bloom);
      composer.addPass(new OutputPass());

      scene.add(new THREE.AmbientLight(0xffffff, 0.55));
      const key = new THREE.DirectionalLight(0xffffff, 1.4);
      key.position.set(5, 7, 6);
      scene.add(key);
      const pGold = new THREE.PointLight(0xf5b83f, 2.5, 16);
      pGold.position.set(-4, 2, 3);
      scene.add(pGold);
      const pCyan = new THREE.PointLight(0x4fd1ff, 2.6, 16);
      pCyan.position.set(4, -2, 3);
      scene.add(pCyan);

      const rig = new THREE.Group();
      scene.add(rig);

      // Inner glowing icosahedron AI core + wireframe shell
      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x101c2a,
        emissive: 0x4fd1ff,
        emissiveIntensity: 0.75,
        roughness: 0.2,
        metalness: 0.75,
        flatShading: true,
      });
      const core = new THREE.Mesh(new THREE.IcosahedronGeometry(1.05, 1), coreMat);
      rig.add(core);

      const cageMat = new THREE.LineBasicMaterial({ color: 0x4fd1ff, transparent: true, opacity: 0.85 });
      const cage = new THREE.LineSegments(new THREE.WireframeGeometry(new THREE.IcosahedronGeometry(1.28, 1)), cageMat);
      rig.add(cage);

      // Three gyroscopic CAN-bus / neural orbital rings
      const r1Mat = new THREE.MeshStandardMaterial({ color: 0xf5b83f, emissive: 0xf5b83f, emissiveIntensity: 0.9, roughness: 0.2, metalness: 0.8 });
      const r2Mat = new THREE.MeshStandardMaterial({ color: 0x4fd1ff, emissive: 0x4fd1ff, emissiveIntensity: 0.85, roughness: 0.2, metalness: 0.8 });
      const r3Mat = new THREE.MeshStandardMaterial({ color: 0x45e08f, emissive: 0x45e08f, emissiveIntensity: 0.8, roughness: 0.2, metalness: 0.8 });

      const ring1 = new THREE.Mesh(new THREE.TorusGeometry(1.85, 0.032, 16, 96), r1Mat);
      const ring2 = new THREE.Mesh(new THREE.TorusGeometry(2.22, 0.024, 16, 96), r2Mat);
      const ring3 = new THREE.Mesh(new THREE.TorusGeometry(2.55, 0.018, 12, 96), r3Mat);
      ring1.rotation.set(Math.PI * 0.35, 0.2, 0);
      ring2.rotation.set(-Math.PI * 0.28, 0.6, 0.4);
      ring3.rotation.set(Math.PI * 0.48, -0.4, 0.2);
      rig.add(ring1, ring2, ring3);

      // Orbiting data nodes along the rings
      const orbNodes: { mesh: THREE.Mesh; radius: number; speed: number; phase: number; tiltX: number; tiltZ: number }[] = [];
      const orbGeo = new THREE.SphereGeometry(0.085, 16, 12);
      for (let i = 0; i < 9; i++) {
        const mat = i % 3 === 0 ? r1Mat : i % 3 === 1 ? r2Mat : r3Mat;
        const m = new THREE.Mesh(orbGeo, mat);
        rig.add(m);
        orbNodes.push({
          mesh: m,
          radius: i % 3 === 0 ? 1.85 : i % 3 === 1 ? 2.22 : 2.55,
          speed: (i % 2 === 0 ? 1 : -1) * (0.55 + (i % 3) * 0.22),
          phase: (i / 9) * Math.PI * 2,
          tiltX: i % 3 === 0 ? 0.6 : i % 3 === 1 ? -0.5 : 0.9,
          tiltZ: i % 3 === 0 ? 0.3 : -0.4,
        });
      }

      // Ambient starfield dust
      const pts = new Float32Array(70 * 3);
      for (let i = 0; i < 70; i++) {
        pts[i * 3] = (Math.random() - 0.5) * 9;
        pts[i * 3 + 1] = (Math.random() - 0.5) * 6;
        pts[i * 3 + 2] = (Math.random() - 0.5) * 6;
      }
      const dustGeo = new THREE.BufferGeometry();
      dustGeo.setAttribute("position", new THREE.BufferAttribute(pts, 3));
      const dustMat = new THREE.PointsMaterial({ color: 0x4fd1ff, size: 0.06, transparent: true, opacity: 0.6 });
      const dust = new THREE.Points(dustGeo, dustMat);
      scene.add(dust);

      const syncTheme = () => {
        const light = document.documentElement.dataset.theme === "light";
        const css = (n: string, f: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f;
        const acc = new THREE.Color(css("--accent", "#f5b83f"));
        const ai = new THREE.Color(css("--ai", "#4fd1ff"));
        const live = new THREE.Color(css("--live", "#45e08f"));
        r1Mat.color.copy(acc); r1Mat.emissive.copy(acc);
        r2Mat.color.copy(ai); r2Mat.emissive.copy(ai);
        r3Mat.color.copy(live); r3Mat.emissive.copy(live);
        coreMat.emissive.copy(ai);
        cageMat.color.copy(ai);
        dustMat.color.copy(ai);
        bloom.strength = light ? 0.22 : 0.78;
      };
      syncTheme();
      new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

      // Smooth pointer parallax
      let tx = 0, ty = 0;
      const box = cv.parentElement!;
      box.addEventListener("pointermove", (e) => {
        const r = box.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 0.9;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 0.7;
      });
      box.addEventListener("pointerleave", () => { tx = 0; ty = 0; });

      const resize = () => {
        const r = box.getBoundingClientRect();
        const w = Math.max(240, r.width);
        const h = Math.max(220, r.height);
        renderer!.setSize(w, h, false);
        composer.setSize(w, h);
        bloom.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      new ResizeObserver(resize).observe(box);

      let visible = true;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.05 }).observe(box);

      let last = performance.now();
      const tick = (now: number) => {
        requestAnimationFrame(tick);
        if (!visible) { last = now; return; }
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;

        rig.rotation.y += (tx - rig.rotation.y) * 0.06;
        rig.rotation.x += (ty - rig.rotation.x) * 0.06;

        if (!reduce) {
          core.rotation.y += dt * 0.45;
          core.rotation.x += dt * 0.22;
          cage.rotation.y -= dt * 0.32;
          ring1.rotation.z += dt * 0.52;
          ring2.rotation.z -= dt * 0.38;
          ring3.rotation.y += dt * 0.28;
          dust.rotation.y += dt * 0.06;

          const t = now * 0.001;
          orbNodes.forEach((o) => {
            const a = t * o.speed + o.phase;
            const x = Math.cos(a) * o.radius;
            const y = Math.sin(a) * o.radius * Math.cos(o.tiltX);
            const z = Math.sin(a) * o.radius * Math.sin(o.tiltX);
            o.mesh.position.set(x, y, z);
          });
        }
        composer.render();
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .hero { padding-block: clamp(24px, 5vw, 56px) clamp(48px, 7vw, 88px); position: relative; overflow-x: clip; }
  .hero::before {
    content: ""; position: absolute; inset: -14% -8% auto auto; width: 68%; height: 115%;
    background: radial-gradient(closest-side, var(--glow), transparent 70%); pointer-events: none;
  }
  .hero::after {
    content: ""; position: absolute; inset: auto auto -20% -10%; width: 55%; height: 95%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ai) 14%, transparent), transparent 72%); pointer-events: none;
  }
  .grid { position: relative; grid-template-rows: auto auto; align-items: stretch; }
  .copy { grid-column: 1 / 8; grid-row: 1 / 3; padding: clamp(24px, 3.4vw, 44px); display: flex; flex-direction: column; justify-content: center; }
  .viz {
    grid-column: 8 / 13; grid-row: 1; padding: 0; position: relative; min-height: 300px; overflow: hidden;
    background:
      radial-gradient(360px 240px at 50% 45%, color-mix(in srgb, var(--ai) 16%, transparent), transparent 75%),
      var(--card);
  }
  .hero-photo { grid-column: 8 / 11; grid-row: 2; }
  .clock { grid-column: 11 / 13; grid-row: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 18px; }
  .kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
  h1 { display: grid; gap: 14px; }
  .name { font-size: clamp(15px, 1.7vw, 18px); font-family: var(--f-mono); font-weight: 500; color: var(--accent); letter-spacing: .06em; text-transform: uppercase; }
  :root[lang="ar"] .name { font-family: var(--f-mono); }
  .title { font-size: clamp(36px, 5.2vw, 64px); font-weight: 700; letter-spacing: -.01em; line-height: 1.02;
    background: linear-gradient(115deg, var(--fg) 42%, var(--accent) 52%, var(--fg) 62%) 0 0 / 250% 100% text; color: transparent; background-position: 100% 0; animation: sheen 1.8s ease-in-out .5s both; }
  .copy:hover .title { animation: sheen2 1.4s ease-in-out both; }
  @keyframes sheen { from { background-position: 100% 0; } to { background-position: -50% 0; } }
  @keyframes sheen2 { from { background-position: 100% 0; } to { background-position: -50% 0; } }
  :root[lang="ar"] .title { line-height: 1.25; letter-spacing: 0; }
  .line { font-size: clamp(19px, 2.2vw, 26px); font-weight: 600; color: var(--muted); }
  .keys { list-style: none; padding: 0; margin: 28px 0 32px; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .keys li { display: flex; gap: 8px; align-items: baseline; font-weight: 600; }
  .keys .mono { color: var(--accent); font-size: 12px; }
  @media (max-width: 520px) { .keys { flex-direction: column; gap: 10px; } }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .ctas { display: grid; grid-template-columns: 1fr 1fr; } .ctas .btn { justify-content: center; } .ctas .primary { grid-column: 1 / -1; } }
  .viz canvas { width: 100%; height: 100%; position: absolute; inset: 0; }
  .viz-open {
    position: absolute; top: 12px; inset-inline-end: 12px; z-index: 2;
    font-size: 11px; text-decoration: none; color: var(--fg);
    padding: 5px 11px; border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    border: 1px solid color-mix(in srgb, var(--ai) 55%, var(--line));
    backdrop-filter: blur(8px);
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  .viz-open:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 0 18px var(--glow); }
  .legend { position: absolute; inset-inline-start: 14px; bottom: 10px; z-index: 2; display: flex; gap: 14px; font-size: 11px; color: var(--muted); flex-wrap: wrap; direction: ltr; pointer-events: none; }
  .legend i { display: inline-block; width: 12px; height: 2px; vertical-align: middle; margin-inline-end: 6px; background: var(--accent); }
  .legend i.n { background: var(--ai); }
  .legend .brs { color: var(--live); }
  .clock .label { display: flex; align-items: center; gap: 8px; }
  .time { font-size: clamp(22px, 2.2vw, 28px); white-space: nowrap; font-weight: 500; color: var(--fg); letter-spacing: .02em; direction: ltr; text-align: start; }
  .zone { font-size: 11px; color: var(--muted); }
  :root[lang="ar"] .zone { font-family: var(--f-body); font-size: 13px; }
  .hero-photo { rotate: -2deg; }
  @media (max-width: 1080px) {
    .copy { grid-column: 1 / -1; grid-row: auto; }
    .viz { grid-column: 1 / 8; grid-row: auto; min-height: 280px; }
    .hero-photo { grid-column: 8 / 13; grid-row: auto; }
    .clock { grid-column: 1 / -1; grid-row: auto; flex-direction: row; align-items: center; }
  }
  @media (max-width: 680px) {
    .viz, .hero-photo { grid-column: 1 / -1; }
    .hero-photo { rotate: 0deg; }
  }
</style>
