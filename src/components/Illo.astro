---
// Hand-drawn "photos" for the Polaroid frames until real photos exist.
// Line art in the site palette (follows the theme); small loops play only while the frame is hovered or in view.
const { name } = Astro.props;
---
<svg class:list={["illo", name]} viewBox="0 0 320 240" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <rect class="sky" width="320" height="240" />
  <g class="dots">{Array.from({ length: 9 }, (_, y) => Array.from({ length: 12 }, (_, x) => <circle cx={14 + x * 27} cy={14 + y * 27} r="1" />))}</g>

  {name === "lab" && (
    <g>
      <path class="ln" d="M14 204H306" />
      {/* monitor with code */}
      <rect class="ln fill" x="28" y="40" width="168" height="112" rx="8" />
      <path class="ln" d="M100 152v22M78 176h44" />
      <g class="code">
        <rect class="a-f" x="42" y="56" width="38" height="6" rx="3" /><rect class="m-f" x="86" y="56" width="58" height="6" rx="3" />
        <rect class="ai-f" x="54" y="72" width="70" height="6" rx="3" /><rect class="m-f" x="130" y="72" width="30" height="6" rx="3" />
        <rect class="m-f" x="54" y="88" width="46" height="6" rx="3" /><rect class="a-f" x="106" y="88" width="62" height="6" rx="3" />
        <rect class="ai-f" x="66" y="104" width="52" height="6" rx="3" />
        <rect class="m-f" x="42" y="120" width="24" height="6" rx="3" />
        <rect class="a-f cursor" x="70" y="118" width="7" height="10" rx="1" />
      </g>
      {/* oscilloscope with a CAN frame */}
      <rect class="ln fill" x="208" y="98" width="92" height="74" rx="6" />
      <rect class="ln scr" x="216" y="106" width="54" height="44" rx="3" />
      <path class="a wave" d="M218 136h6v-16h6v16h4v-16h10v16h3v-16h3v16h3v-16h3v16h6v-16h4v16h6v-16h6v16h4v-16h10v16" />
      <circle class="ln" cx="285" cy="116" r="6" /><circle class="ln" cx="285" cy="138" r="4" />
      <path class="ln" d="M216 160h54" />
      {/* board with chip + LED */}
      <rect class="ln fill" x="112" y="182" width="74" height="22" rx="3" />
      <rect class="ai-f" x="138" y="187" width="16" height="12" rx="2" />
      <path class="m" d="M118 188v10M123 188v10M128 188v10M164 188v10M169 188v10" />
      <circle class="led-b" cx="178" cy="193" r="3" />
      {/* cable from board to scope */}
      <path class="ai cable" d="M186 194c22 0 18-24 30-24" />
      {/* mug */}
      <path class="ln fill" d="M40 176h26v22a6 6 0 0 1-6 6H46a6 6 0 0 1-6-6z" /><path class="ln" d="M66 182h4a5 5 0 0 1 0 10h-4" />
      <path class="m steam" d="M48 170c-4-6 4-8 0-14M58 170c-4-6 4-8 0-14" />
    </g>
  )}

  {name === "sport" && (
    <g>
      {/* dumbbell */}
      <g class="bob">
        <path class="ln" d="M110 78h100" />
        <rect class="a-f" x="92" y="56" width="14" height="44" rx="3" /><rect class="a-f" x="76" y="62" width="14" height="32" rx="3" />
        <rect class="a-f" x="214" y="56" width="14" height="44" rx="3" /><rect class="a-f" x="230" y="62" width="14" height="32" rx="3" />
      </g>
      {/* pool lanes */}
      <rect class="ln water" x="14" y="128" width="292" height="98" rx="6" />
      <path class="m lane" d="M14 160h292M14 194h292" />
      <g class="waves">
        <path class="ai" d="M-40 144q10-8 20 0t20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0" />
        <path class="ai o" d="M-40 178q10-8 20 0t20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0" />
        <path class="ai" d="M-40 212q10-8 20 0t20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0" />
      </g>
      {/* lap counter */}
      <rect class="ln fill" x="248" y="20" width="58" height="30" rx="4" />
      <path class="a" d="M266 28v14M276 28h8v7h-8v7h8" />
    </g>
  )}

  {name === "game" && (
    <g>
      {/* minimap: two bases, three lanes, a river, wards */}
      <rect class="ln fill" x="90" y="24" width="140" height="192" rx="10" transform="rotate(-0)" />
      <path class="ai river" d="M92 150c30-6 40-30 70-34s48-32 66-40" />
      <path class="m" d="M104 204V44h0M104 204h112M104 44l112 0M216 44v160M108 200l104-152" />
      <circle class="ai-f" cx="108" cy="200" r="7" /><circle class="a-f" cx="212" cy="48" r="7" />
      <g class="towers">
        <rect class="ai-f" x="101" y="150" width="6" height="6" /><rect class="ai-f" x="150" y="201" width="6" height="6" /><rect class="ai-f" x="134" y="160" width="6" height="6" />
        <rect class="a-f" x="213" y="92" width="6" height="6" /><rect class="a-f" x="164" y="41" width="6" height="6" /><rect class="a-f" x="180" y="80" width="6" height="6" />
      </g>
      <g class="wards">
        <circle class="ward" cx="150" cy="118" r="4" /><circle class="ward" cx="186" cy="146" r="4" style="--w:.7s" /><circle class="ward" cx="128" cy="96" r="4" style="--w:1.4s" />
      </g>
      <g class="vision"><circle class="a o" cx="150" cy="118" r="18" /><circle class="a o" cx="186" cy="146" r="18" /><circle class="a o" cx="128" cy="96" r="18" /></g>
      {/* timer */}
      <rect class="ln fill" x="24" y="24" width="50" height="22" rx="4" /><path class="a" d="M34 31v8M40 31h6v4h-6v4h6M52 33v.1M52 37v.1M57 31h6v8h-6z" />
    </g>
  )}

  {name === "code" && (
    <g>
      <rect class="ln fill" x="30" y="30" width="260" height="170" rx="10" />
      <path class="ln" d="M30 54h260" />
      <circle class="a-f" cx="46" cy="42" r="4" /><circle class="m-f" cx="60" cy="42" r="4" /><circle class="ai-f" cx="74" cy="42" r="4" />
      <g class="term">
        <text x="44" y="80"><tspan class="a-t">$</tspan> docker compose up -d</text>
        <text x="44" y="102" class="m-t">✓ all services up</text>
        <text x="44" y="124"><tspan class="a-t">$</tspan> make flash</text>
        <text x="44" y="146" class="ai-t">→ board ready · 0 errors</text>
        <text x="44" y="172"><tspan class="a-t">$</tspan></text>
        <rect class="a-f cursor" x="58" y="161" width="8" height="14" rx="1" />
      </g>
      <path class="ln" d="M110 214h100" />
    </g>
  )}

  {name === "travel" && (
    <g>
      {/* simplified Europe outline as a dotted coastline + route */}
      <path class="m coast" d="M40 60c30-14 64-6 80 10s40 4 60-6 46 2 58 20 34 18 44 40M30 150c24-4 40 10 60 4s30-20 54-14 30 24 52 20 40-10 64 2" />
      <path class="a route" d="M120 66C150 80 170 70 196 92S180 140 150 150 96 160 76 176" />
      <g class="pins">
        <circle class="a-f" cx="120" cy="66" r="5" /><circle class="a-f" cx="196" cy="92" r="5" />
        <circle class="a-f" cx="150" cy="150" r="5" /><circle class="a-f" cx="76" cy="176" r="5" />
        <circle class="ai-f" cx="244" cy="168" r="5" />
      </g>
      <path class="ai o" d="M150 150C190 150 220 170 244 168" stroke-dasharray="4 6" />
      <g class="plane"><path class="ln fill" d="M-12 0l8-3 4-9h4l-2 9 8-1 3-4h3l-1 5 1 5h-3l-3-4-8-1 2 9h-4l-4-9z" /></g>
      <path class="ln" d="M14 214h292" />
    </g>
  )}
</svg>

<style>
  .illo { width: 100%; height: 100%; display: block; }
  .sky { fill: var(--panel-2); }
  .dots circle { fill: var(--line-2); opacity: .5; }
  .ln { stroke: var(--fg); stroke-width: 2.4; opacity: .85; }
  .fill { fill: var(--panel); }
  .scr { fill: var(--bg-2); }
  .water { fill: color-mix(in srgb, var(--ai) 10%, var(--panel)); }
  .a { stroke: var(--accent); stroke-width: 2.4; }
  .ai { stroke: var(--ai); stroke-width: 2.4; }
  .m { stroke: var(--muted); stroke-width: 2; opacity: .7; }
  .o { opacity: .45; }
  .a-f { fill: var(--accent); } .ai-f { fill: var(--ai); } .m-f { fill: var(--muted); opacity: .6; }
  .led-b { fill: var(--live); }
  text { font: 500 12.5px var(--f-mono); fill: var(--fg); direction: ltr; }
  .a-t { fill: var(--accent); } .m-t { fill: var(--muted); } .ai-t { fill: var(--ai); }
  .coast { stroke-dasharray: 2 7; }
  .route { stroke-dasharray: 6 6; }
  .plane { offset-path: path("M120 66C150 80 170 70 196 92S180 140 150 150 96 160 76 176"); offset-rotate: auto; }
  .ward { fill: var(--accent); }
  .vision circle { transform-box: fill-box; transform-origin: center; }

  /* loops: always for the hero, on hover for the frames */
  .cursor { animation: blink 1.1s steps(1) infinite; }
  .wave { stroke-dasharray: 260; animation: trace 3.2s linear infinite; }
  .steam { stroke-dasharray: 20 30; animation: steam 2.6s linear infinite; }
  .led-b { animation: blink 1.6s steps(1) infinite; }
  .bob { animation: bob 3s ease-in-out infinite; }
  .waves { animation: swim 4s linear infinite; }
  .vision circle { animation: ward 2.4s ease-out infinite; }
  .vision circle:nth-child(2) { animation-delay: .8s; } .vision circle:nth-child(3) { animation-delay: 1.6s; }
  .route { animation: dash 2.4s linear infinite; }
  .plane { animation: fly 9s ease-in-out infinite; }
  .illo:not(.lab) * { animation-play-state: paused; }
  :global(.polaroid:hover) .illo *, :global(.polaroid.in) .illo * { animation-play-state: running; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes trace { from { stroke-dashoffset: 260; } to { stroke-dashoffset: -260; } }
  @keyframes steam { to { stroke-dashoffset: -50; } }
  @keyframes bob { 50% { transform: translateY(-8px); } }
  @keyframes swim { to { transform: translateX(40px); } }
  @keyframes ward { from { transform: scale(.3); opacity: .9; } to { transform: scale(1.4); opacity: 0; } }
  @keyframes dash { to { stroke-dashoffset: -24; } }
  @keyframes fly { 0% { offset-distance: 0%; } 70%, 100% { offset-distance: 100%; } }
  @media (prefers-reduced-motion: reduce) { .illo * { animation: none !important; } }
</style>
