---
// A pipeline diagram: steps joined by links with a packet flowing along them.
// Horizontal on wide screens, vertical on phones; mirrors itself in RTL.
const { steps, compact = false } = Astro.props;
---
<ol class:list={["flow", { compact }]} role="list">
  {steps.map((s, i) => (
    <li style={`--i:${i}`}>
      <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
      <span class="s">{s}</span>
      {i < steps.length - 1 && <span class="link" aria-hidden="true"><b></b></span>}
    </li>
  ))}
</ol>

<style>
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 28px; }
  .flow li { position: relative; background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 14px 14px 16px; min-width: 0; }
  .flow li:first-child { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
  .flow li:last-child { border-color: color-mix(in srgb, var(--ai) 50%, var(--line)); }
  .n { display: block; font-size: 11px; color: var(--accent); margin-bottom: 6px; }
  .s { font-size: 14px; font-weight: 600; line-height: 1.35; display: block; overflow-wrap: anywhere; }
  .link { position: absolute; top: 50%; inset-inline-start: 100%; width: 28px; height: 2px; background: var(--line); overflow: hidden; }
  /* the packet moves with transform only (compositor, no layout per frame): b spans the link, b::before is the dot */
  .link b { position: absolute; inset: 0; animation: pkt 1.6s linear infinite; animation-delay: calc(var(--i) * .32s); will-change: transform; }
  .link b::before { content: ""; position: absolute; top: 0; inset-inline-start: 0; width: 10px; height: 2px; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  @keyframes pkt { from { transform: translateX(-10px); } to { transform: translateX(100%); } }
  @keyframes pktr { from { transform: translateX(10px); } to { transform: translateX(-100%); } }
  :global(:root[dir="rtl"]) .link b { animation-name: pktr; }
  .compact li { padding: 10px 12px; }
  .compact .s { font-size: 13px; }
  @media (max-width: 760px) {
    .flow { grid-auto-flow: row; gap: 18px; }
    .link { top: 100%; inset-inline-start: 22px; width: 2px; height: 18px; }
    .link b, :global(:root[dir="rtl"]) .link b { animation-name: pktv; }
    .link b::before { width: 2px; height: 8px; }
    @keyframes pktv { from { transform: translateY(-8px); } to { transform: translateY(100%); } }
  }
</style>
