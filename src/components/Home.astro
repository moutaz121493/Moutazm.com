---
import Hero from "./Hero.astro";
import Flow from "./Flow.astro";
import { ui, path, experience, education, skills, now, hobbies, LINKS } from "../content/site.js";
import { projects } from "../content/projects.js";
import { todo } from "../lib/text.js";

const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ICON = {
  sport: '<circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 0 0 18M3.5 9h17M3.5 15h17"/>',
  game: '<rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  travel: '<path d="M2 16l20-6-3-3-7 2L7 4 5 5l3 6-5 1.5"/><path d="M3 21h18"/>',
};
---
<Hero lang={lang} />

<section class="block" id="about">
  <div class="wrap about">
    <div class="sec-head reveal"><span class="idx">01</span><h2>{t.about.h}</h2></div>
    <div class="about-grid">
      <p class="lead reveal">{t.about.lead}</p>
      <div class="body reveal">{t.about.body.map((p) => <p>{p}</p>)}</div>
    </div>
  </div>
</section>

<section class="block" id="projects">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">02</span><h2>{t.projects.h}</h2><p class="sub">{t.projects.sub}</p></div>
    <div class="projects">
      {projects.map((p, i) => (
        <a class:list={["proj", "reveal", { wide: i === 0 }]} href={base + path(lang, `/projects/${p.slug}`)}>
          <div class="proj-top">
            <span class:list={["status", p.status]}><i></i>{t.projects.status[p.status]}</span>
            <span class="mono pn">P{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3>{p[lang].title}</h3>
          <p class="tag">{p[lang].tagline}</p>
          {i === 0 && <Flow steps={p.flow} compact />}
          <div class="chips">{p.tags.map((x) => <span class="chip">{x}</span>)}</div>
          <span class="more">{t.projects.more}
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="block" id="experience">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">03</span><h2>{t.work.h}</h2></div>
    <ol class="timeline">
      {experience.map((e) => (
        <li class="reveal">
          <div class="when mono">{e.from} — {e.to ?? t.work.present}</div>
          <div class="what">
            <h3><span set:html={todo(e.role[lang])} /></h3>
            <p class="org"><a href={e.url} rel="noopener" target="_blank">{e.org}</a> · <span set:html={todo(e.place[lang])} /></p>
            <p class="muted">{e.blurb[lang]}</p>
            <ul>{e.points[lang].map((x) => <li>{x}</li>)}</ul>
          </div>
        </li>
      ))}
      {education.map((e) => (
        <li class="reveal edu">
          <div class="when mono" set:html={todo(e.when[lang])} />
          <div class="what">
            <h3>{e.degree[lang]}</h3>
            <p class="org" set:html={todo(e.school)} />
            {e.note && <p class="muted">{e.note[lang]}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="block" id="now">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">04</span><h2>{t.now.h}</h2></div>
    <div class="now">
      {now[lang].map((n) => <div class="card reveal"><span class="label">{n.k}</span><p>{n.v}</p></div>)}
    </div>
  </div>
</section>

<section class="block" id="skills">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">05</span><h2>{t.skills.h}</h2></div>
    <div class="skills">
      {skills[lang].map((g) => (
        <div class="card reveal"><h3>{g.h}</h3><div class="chips">{g.items.map((x) => <span class="chip">{x}</span>)}</div></div>
      ))}
    </div>
  </div>
</section>

<section class="block" id="beyond">
  <div class="wrap">
    <div class="sec-head reveal"><span class="idx">06</span><h2>{t.beyond.h}</h2></div>
    <div class="beyond">
      {hobbies[lang].map((h) => (
        <div class="hobby reveal">
          <div class="ph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICON[h.icon]} />
          </div>
          <h3>{h.h}</h3>
          <p set:html={todo(h.v)} />
        </div>
      ))}
    </div>
  </div>
</section>

<section class="block" id="contact">
  <div class="wrap contact reveal">
    <div class="sec-head"><span class="idx">07</span><h2>{t.contact.h}</h2></div>
    <p class="lead">{t.contact.body}</p>
    <div class="ctas">
      <a class="btn primary" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
      <a class="btn" href={LINKS.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      <a class="btn" href={LINKS.github} rel="noopener" target="_blank">GitHub</a>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 48px; }
  .lead { font: 600 clamp(22px, 2.6vw, 30px)/1.3 var(--f-display); }
  :root[lang="ar"] .lead { line-height: 1.6; }
  .body { display: grid; gap: 16px; color: var(--muted); }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; gap: 24px; } }

  .projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .proj { display: flex; flex-direction: column; gap: 14px; text-decoration: none; background: var(--panel); border: 1px solid var(--line);
    border-radius: 14px; padding: 24px; position: relative; overflow: hidden; transition: border-color .25s, transform .25s; min-width: 0; }
  .proj::after { content: ""; position: absolute; inset: 0; background: radial-gradient(500px 200px at var(--mx, 50%) -10%, var(--glow), transparent 70%); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .proj:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); transform: translateY(-3px); }
  .proj:hover::after { opacity: 1; }
  .proj.wide { grid-column: 1 / -1; }
  .proj-top { display: flex; justify-content: space-between; align-items: center; }
  .pn { color: var(--muted); font-size: 12px; }
  .proj h3 { font-size: clamp(22px, 2.4vw, 28px); }
  .tag { color: var(--muted); }
  .more { margin-top: auto; display: inline-flex; gap: 8px; align-items: center; font-weight: 600; color: var(--accent); }
  .more svg { width: 18px; height: 18px; transition: transform .2s; }
  .proj:hover .more svg { transform: translateX(4px); }
  :root[dir="rtl"] .more svg { transform: scaleX(-1); }
  :root[dir="rtl"] .proj:hover .more svg { transform: scaleX(-1) translateX(4px); }
  @media (max-width: 760px) { .projects { grid-template-columns: 1fr; } }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 34px; }
  .timeline::before { content: ""; position: absolute; inset-block: 6px; inset-inline-start: 150px; width: 2px;
    background: linear-gradient(var(--accent), var(--ai) 60%, var(--line)); transform-origin: top; animation: draw 1.6s ease-out both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
  @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .timeline > li { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 36px; position: relative; }
  .timeline > li::before { content: ""; position: absolute; inset-inline-start: 145px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .timeline > li.edu::before { border-color: var(--ai); }
  .when { color: var(--muted); font-size: 13px; padding-top: 2px; }
  .what { display: grid; gap: 8px; }
  .org a { color: var(--accent); text-decoration: none; }
  .muted { color: var(--muted); }
  .what ul { margin: 6px 0 0; padding-inline-start: 18px; display: grid; gap: 6px; }
  .what ul li::marker { color: var(--accent); }
  @media (max-width: 700px) {
    .timeline::before { inset-inline-start: 5px; }
    .timeline > li { grid-template-columns: 1fr; gap: 6px; padding-inline-start: 28px; }
    .timeline > li::before { inset-inline-start: 0; }
  }

  .now { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .now .card { display: grid; gap: 10px; align-content: start; }
  .now .label { color: var(--accent); }
  @media (max-width: 960px) { .now { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .now { grid-template-columns: 1fr; } }

  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .skills .card { display: grid; gap: 14px; align-content: start; }
  .skills h3 { font-size: 17px; }
  .skills .chip { color: var(--fg); background: var(--panel-2); }

  .beyond { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .hobby { display: grid; gap: 10px; align-content: start; }
  .ph { aspect-ratio: 4 / 3; border-radius: 12px; border: 1px solid var(--line); display: grid; place-items: center; color: var(--accent);
    background: radial-gradient(circle at 30% 20%, var(--glow), transparent 60%), var(--panel); }
  .ph svg { width: 42px; height: 42px; }
  .hobby p { color: var(--muted); font-size: 15px; }
  @media (max-width: 960px) { .beyond { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .beyond { grid-template-columns: 1fr; } }

  .contact .lead { max-width: 760px; margin-bottom: 28px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

<script>
  // card glow follows the pointer
  document.querySelectorAll<HTMLElement>(".proj").forEach((el) =>
    el.addEventListener("pointermove", (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
    }),
  );
</script>
