---
import Base from "../../../layouts/Base.astro";
import Flow from "../../../components/Flow.astro";
import CanTiming from "../../../components/CanTiming.astro";
import CanFrame from "../../../components/CanFrame.astro";
import AiSystemVisual from "../../../components/AiSystemVisual.astro";
import { LANGS, ui, path } from "../../../content/site.js";
import { projects } from "../../../content/projects.js";

export function getStaticPaths() {
  return LANGS.flatMap((l) =>
    projects.map((p, i) => ({ params: { lang: l === "en" ? undefined : l, slug: p.slug }, props: { lang: l, p, i } })),
  );
}
const { lang, p, i } = Astro.props;
const t = ui[lang].projects;
const c = p[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const next = projects[(i + 1) % projects.length];
const prev = projects[(i - 1 + projects.length) % projects.length];
const A = {
  en: { ask: "Ask about this project", q: (x) => `Tell me about your project "${x}": what problem does it solve and how did you build it?`, of: "Project", prev: "Previous", next: "Next" },
  de: { ask: "Frag zu diesem Projekt", q: (x) => `Erzähl mir von deinem Projekt „${x}“: welches Problem löst es und wie hast du es gebaut?`, of: "Projekt", prev: "Zurück", next: "Weiter" },
  ar: { ask: "اسأل عن هذا المشروع", q: (x) => `حدّثني عن مشروعك «${x}»: ما المشكلة التي يحلّها وكيف بنيته؟`, of: "مشروع", prev: "السابق", next: "التالي" },
}[lang];
const num = (n) => String(n + 1).padStart(2, "0");
---
<Base lang={lang} route={`/projects/${p.slug}`} title={`${c.title} · Moutaz Mohammad`} description={c.tagline}>
  <article class="wrap proj">
    <a class="back" href={base + path(lang, "/") + "#projects"}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{t.back}</a>
    <header class="head">
      <div class="meta">
        <span class:list={["status", p.status]}><i></i>{t.status[p.status]}</span>
        <span class="mono count">{A.of} {num(i)} / {num(projects.length - 1)}</span>
      </div>
      <h1>{c.title}</h1>
      <p class="tagline">{c.tagline}</p>
      <div class="chips">{p.tags.map((x) => <span class="chip">{x}</span>)}</div>
      <div class="acts">
        <button class="btn primary" type="button" data-ask={A.q(c.title)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l.9-5.4A8 8 0 1 1 21 12z"/></svg>{A.ask}</button>
        {p.repo && <a class="btn" href={p.repo} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.4-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>GitHub</a>}
      </div>
    </header>

    {[].concat(p.tool || []).includes("can-timing") && <CanTiming lang={lang} />}
    {[].concat(p.tool || []).includes("can-frame") && <CanFrame lang={lang} />}
    {[].concat(p.tool || []).includes("ai-visual") && <AiSystemVisual slug={p.slug} lang={lang} />}

    <section class="part">
      <h2 class="label">{t.problem}</h2>
      <p class="big">{c.problem}</p>
    </section>

    {![].concat(p.tool || []).includes("ai-visual") && (
      <section class="part">
        <h2 class="label">{t.architecture}</h2>
        <Flow steps={p.flow} />
      </section>
    )}

    <div class="two">
      <section class="part">
        <h2 class="label">{t.decisions}</h2>
        <ol class="list">{c.decisions.map((d) => <li>{d}</li>)}</ol>
      </section>
      <section class="part">
        <h2 class="label">{t.learned}</h2>
        <ul class="list learned">{c.learned.map((d) => <li>{d}</li>)}</ul>
        <h2 class="label repo-h">{t.repo}</h2>
        {p.repo ? <a class="btn" href={p.repo} rel="noopener" target="_blank">GitHub</a> : <p class="soon mono">{t.repoSoon}</p>}
      </section>
    </div>

    <nav class="pager" aria-label={t.back}>
      <a class="pg prev" href={base + path(lang, `/projects/${prev.slug}`)} rel="prev">
        <span class="label">{lang === "ar" ? "→" : "←"} {A.prev}</span><b>{prev[lang].title}</b><small>{prev[lang].tagline}</small>
      </a>
      <a class="pg next" href={base + path(lang, `/projects/${next.slug}`)} rel="next">
        <span class="label">{A.next} {lang === "ar" ? "←" : "→"}</span><b>{next[lang].title}</b><small>{next[lang].tagline}</small>
      </a>
    </nav>
  </article>
</Base>

<style>
  .proj { padding-block: 40px 90px; display: grid; gap: 44px; }
  .back { display: inline-flex; gap: 8px; align-items: center; color: var(--muted); text-decoration: none; font-size: 14px; width: max-content; min-height: 44px; }
  .back:hover { color: var(--fg); }
  .back svg { width: 18px; height: 18px; }
  :root[dir="rtl"] .back svg { transform: scaleX(-1); }
  .head { display: grid; gap: 16px; max-width: 860px; }
  h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 700; }
  .tagline { font-size: clamp(18px, 2vw, 22px); color: var(--muted); }
  .part { display: grid; gap: 16px; }
  .part > .label { margin: 0; }
  .big { font-size: clamp(18px, 2vw, 21px); max-width: 860px; }
  .two { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 44px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  .list { margin: 0; padding-inline-start: 22px; display: grid; gap: 14px; }
  .list li::marker { color: var(--accent); font-family: var(--f-mono); }
  .learned { color: var(--muted); }
  .repo-h { margin-top: 18px !important; }
  .soon { color: var(--muted); font-size: 14px; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .count { font-size: 12px; color: var(--muted); letter-spacing: .06em; }
  h1 { background: linear-gradient(180deg, var(--fg) 55%, color-mix(in srgb, var(--fg) 70%, var(--accent))); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .06em; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .acts .btn { cursor: pointer; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pg { display: grid; gap: 4px; padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; text-decoration: none; background: var(--panel); transition: border-color .2s, transform .3s var(--spring); min-width: 0; }
  .pg.next { text-align: end; }
  .pg:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pg .label { color: var(--accent); }
  .pg b { font: 600 19px/1.25 var(--f-display); }
  .pg small { color: var(--muted); font-size: 13.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :root[data-theme="light"] .pg { border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .pg.next { text-align: start; } }
</style>
