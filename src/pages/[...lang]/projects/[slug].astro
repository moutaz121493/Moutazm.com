---
import Base from "../../../layouts/Base.astro";
import Flow from "../../../components/Flow.astro";
import CanTiming from "../../../components/CanTiming.astro";
import { LANGS, ui, path } from "../../../content/site.js";
import { projects } from "../../../content/projects.js";

export function getStaticPaths() {
  return LANGS.flatMap((l) =>
    projects.map((p, i) => ({ params: { lang: l === "en" ? undefined : l, slug: p.slug }, props: { lang: l, p, i } })),
  );
}
const { lang, p, i } = Astro.props;
const t = ui[lang].projects;
const c = p[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const next = projects[(i + 1) % projects.length];
---
<Base lang={lang} route={`/projects/${p.slug}`} title={`${c.title} · Moutaz Mohammad`} description={c.tagline}>
  <article class="wrap proj">
    <a class="back" href={base + path(lang, "/") + "#projects"}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{t.back}</a>
    <header class="head">
      <span class:list={["status", p.status]}><i></i>{t.status[p.status]}</span>
      <h1>{c.title}</h1>
      <p class="tagline">{c.tagline}</p>
      <div class="chips">{p.tags.map((x) => <span class="chip">{x}</span>)}</div>
    </header>

    {p.tool === "can-timing" && <CanTiming lang={lang} />}

    <section class="part">
      <h2 class="label">{t.problem}</h2>
      <p class="big">{c.problem}</p>
    </section>

    <section class="part">
      <h2 class="label">{t.architecture}</h2>
      <Flow steps={p.flow} />
    </section>

    <div class="two">
      <section class="part">
        <h2 class="label">{t.decisions}</h2>
        <ol class="list">{c.decisions.map((d) => <li>{d}</li>)}</ol>
      </section>
      <section class="part">
        <h2 class="label">{t.learned}</h2>
        <ul class="list learned">{c.learned.map((d) => <li>{d}</li>)}</ul>
        <h2 class="label repo-h">{t.repo}</h2>
        {p.repo ? <a class="btn" href={p.repo} rel="noopener" target="_blank">GitHub</a> : <p class="soon mono">{t.repoSoon}</p>}
      </section>
    </div>

    <a class="next" href={base + path(lang, `/projects/${next.slug}`)}>
      <span class="label">→</span><span>{next[lang].title}</span>
    </a>
  </article>
</Base>

<style>
  .proj { padding-block: 40px 90px; display: grid; gap: 44px; }
  .back { display: inline-flex; gap: 8px; align-items: center; color: var(--muted); text-decoration: none; font-size: 14px; width: max-content; }
  .back:hover { color: var(--fg); }
  .back svg { width: 18px; height: 18px; }
  :root[dir="rtl"] .back svg { transform: scaleX(-1); }
  .head { display: grid; gap: 16px; max-width: 860px; }
  h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 700; }
  .tagline { font-size: clamp(18px, 2vw, 22px); color: var(--muted); }
  .part { display: grid; gap: 16px; }
  .part > .label { margin: 0; }
  .big { font-size: clamp(18px, 2vw, 21px); max-width: 860px; }
  .two { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 44px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  .list { margin: 0; padding-inline-start: 22px; display: grid; gap: 14px; }
  .list li::marker { color: var(--accent); font-family: var(--f-mono); }
  .learned { color: var(--muted); }
  .repo-h { margin-top: 18px !important; }
  .soon { color: var(--muted); font-size: 14px; }
  .next { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 24px; border: 1px solid var(--line); border-radius: 14px;
    text-decoration: none; font: 600 20px var(--f-display); background: var(--panel); transition: border-color .2s; }
  .next:hover { border-color: var(--accent); }
  .next .label { order: 2; color: var(--accent); font-size: 20px; }
  :root[dir="rtl"] .next .label { transform: scaleX(-1); }
</style>
