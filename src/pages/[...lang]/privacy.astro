---
import Base from "../../layouts/Base.astro";
import { LANGS, LINKS, LEGAL } from "../../content/site.js";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === "en" ? undefined : l }, props: { lang: l } }));
}
const { lang } = Astro.props;
// Not legal advice. Controller details come from LEGAL (same as the Impressum).
const who = `${LEGAL.name}, ${LEGAL.street}, ${LEGAL.city}, ${LEGAL.country} · ${LINKS.email}`;
const T = {
  en: { h: "Privacy", p: [
    `Controller: ${who}.`,
    "This is a private, static portfolio website. It sets no cookies, uses no analytics or tracking, and loads no third-party content. Fonts are served from this site.",
    "Hosting: Cloudflare, Inc. (USA). When you open the site, Cloudflare processes technically necessary data such as your IP address in server logs to deliver the pages and protect against attacks (Art. 6(1)(f) GDPR). Cloudflare is certified under the EU-US Data Privacy Framework.",
    `If you write me an e-mail (${LINKS.email}), I use your message only to answer you.`,
    "Chat \u201cAsk about me\u201d: questions you type into the chat (not the topic buttons) are sent to Google's Gemini API (Google LLC / Google Ireland Ltd.) to generate an answer from my public CV, and are not stored on this site. Google may process and, on the free tier, use these inputs to improve its services; please don't type personal data. Legal basis: Art. 6(1)(f) GDPR (answering your question). Google is certified under the EU-US Data Privacy Framework.",
    "You have the right to access, rectification, erasure, restriction of processing and objection, and the right to lodge a complaint with a supervisory authority, e.g. the Landesbeauftragte für den Datenschutz Niedersachsen.",
  ] },
  de: { h: "Datenschutz", p: [
    `Verantwortlicher: ${who}.`,
    "Dies ist eine private, statische Portfolio-Website. Sie setzt keine Cookies, nutzt keine Analyse- oder Tracking-Dienste und lädt keine Inhalte Dritter. Schriftarten werden von dieser Website ausgeliefert.",
    "Hosting: Cloudflare, Inc. (USA). Beim Aufruf verarbeitet Cloudflare technisch notwendige Daten wie Ihre IP-Adresse in Server-Logs, um die Seiten auszuliefern und vor Angriffen zu schützen (Art. 6 Abs. 1 lit. f DSGVO). Cloudflare ist nach dem EU-US Data Privacy Framework zertifiziert.",
    `Wenn Sie mir eine E-Mail schreiben (${LINKS.email}), nutze ich Ihre Nachricht nur, um Ihnen zu antworten.`,
    "Chat \u201eFrag mich\u201c: Fragen, die Sie in den Chat eintippen (nicht die Themen-Buttons), werden an die Gemini-API von Google (Google LLC / Google Ireland Ltd.) gesendet, um eine Antwort aus meinem öffentlichen Lebenslauf zu erzeugen, und auf dieser Website nicht gespeichert. Google kann diese Eingaben verarbeiten und im kostenlosen Tarif zur Verbesserung seiner Dienste nutzen; bitte geben Sie keine personenbezogenen Daten ein. Rechtsgrundlage: Art. 6 Abs. 1 lit. f DSGVO (Beantwortung Ihrer Frage). Google ist nach dem EU-US Data Privacy Framework zertifiziert.",
    "Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung und Widerspruch sowie das Recht auf Beschwerde bei einer Aufsichtsbehörde, z. B. der Landesbeauftragten für den Datenschutz Niedersachsen.",
  ] },
  ar: { h: "الخصوصية", p: [
    `المسؤول عن البيانات: ${who}.`,
    "هذا موقع شخصي ثابت. لا يستخدم ملفات تعريف الارتباط (cookies)، ولا أدوات تحليل أو تتبّع، ولا يحمّل محتوى من أطراف أخرى. الخطوط تُحمَّل من هذا الموقع نفسه.",
    "الاستضافة: شركة Cloudflare (الولايات المتحدة). عند فتح الموقع تعالج Cloudflare بيانات ضرورية تقنياً مثل عنوان IP في سجلات الخادم لتوصيل الصفحات والحماية من الهجمات (المادة 6(1)(f) من GDPR). Cloudflare حاصلة على شهادة EU-US Data Privacy Framework.",
    `إذا راسلتني على البريد (${LINKS.email}) أستخدم رسالتك فقط للرد عليك.`,
    "محادثة «اسألني»: الأسئلة التي تكتبها في المحادثة (وليس أزرار المواضيع) تُرسل إلى واجهة Gemini من Google (Google LLC / Google Ireland Ltd.) لتوليد إجابة من سيرتي الذاتية العامة، ولا تُحفظ على هذا الموقع. قد تعالج Google هذه المدخلات وتستخدمها في الخطة المجانية لتحسين خدماتها؛ لا تكتب بيانات شخصية. الأساس القانوني: المادة 6(1)(f) من GDPR (الرد على سؤالك). Google حاصلة على شهادة EU-US Data Privacy Framework.",
    "لك الحق في الاطلاع على بياناتك وتصحيحها وحذفها وتقييد معالجتها والاعتراض عليها، والحق في تقديم شكوى لدى جهة رقابية، مثل مفوّضة حماية البيانات في ولاية سكسونيا السفلى.",
  ] },
}[lang];
---
<Base lang={lang} route="/privacy" title={`${T.h} · Moutaz Mohammad`} description={T.p[1]}>
  <article class="wrap legal"><h1>{T.h}</h1>{T.p.map((x) => <p>{x}</p>)}</article>
</Base>
<style>
  .legal { padding-block: 48px 90px; max-width: 760px; display: grid; gap: 18px; }
  h1 { font-size: clamp(32px, 5vw, 48px); margin-bottom: 10px; }
  p { color: var(--muted); }
</style>
