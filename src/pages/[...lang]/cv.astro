---
import Base from "../../layouts/Base.astro";
import { LANGS, ui, path, experience, education, skills, languages, certifications, LINKS } from "../../content/site.js";
import { projects } from "../../content/projects.js";
import { todo } from "../../lib/text.js";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === "en" ? undefined : l }, props: { lang: l } }));
}
const { lang } = Astro.props;
const t = ui[lang];
const c = t.cv;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pdfHref = `${base}/cv/moutaz-mohammad-cv-${lang}.pdf`;
const pdfFileName = lang === "de" ? "Moutaz-Mohammad-Lebenslauf-DE.pdf" : lang === "ar" ? "Moutaz-Mohammad-CV-AR.pdf" : "Moutaz-Mohammad-CV-EN.pdf";
---
<Base lang={lang} route="/cv" title={`${c.h} · Moutaz Mohammad`} description={`${c.h}: Moutaz Mohammad, ${t.hero.title}`}>
  <article class="wrap cv">
    <header class="cv-hero tile" data-notilt>
      <div class="cv-id">
        <span class="label"><span class="led gold" aria-hidden="true"></span>{c.h}</span>
        <h1>Moutaz Mohammad</h1>
        <p class="role">{t.hero.title} <span>— {t.hero.line}</span></p>
        <div class="contact mono">
          <span>{t.hero.kicker}</span>
          <span>·</span>
          <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
          <span>·</span>
          <a href="https://moutazm.com">moutazm.com</a>
          <span>·</span>
          <a href={LINKS.linkedin} rel="noopener" target="_blank">LinkedIn</a>
          <span>·</span>
          <a href={LINKS.github} rel="noopener" target="_blank">GitHub</a>
        </div>
      </div>
      <div class="dl no-print">
        <a class="btn primary dl-btn" href={pdfHref} download={pdfFileName}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
          <span>{c.download}</span>
        </a>
      </div>
    </header>

    <section class="cv-sec">
      <h2 class="label">{c.summary}</h2>
      <div class="card summary-card" data-notilt>
        <p class="summary-lead">{t.about.lead}</p>
        <div class="summary-body">
          {t.about.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="cv-sec">
      <h2 class="label">{c.exp}</h2>
      <div class="stack">
        {experience.map((e) => (
          <div class="card row" data-notilt>
            <div class="when mono">{e.from} – {e.to ?? t.work.present}</div>
            <div class="row-main">
              <h3><span set:html={todo(e.role[lang])} /> <span class="at">· {e.org}</span></h3>
              <p class="muted place"><span set:html={todo(e.place[lang])} /> — {e.blurb[lang]}</p>
              <ul>{e.points[lang].map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-sec">
      <h2 class="label">{c.projects}</h2>
      <div class="proj-grid">
        {projects.filter((p) => p.status !== "planned").map((p) => (
          <div class="card pcard" data-notilt>
            <div class="pcard-top">
              <h3><a href={base + path(lang, `/projects/${p.slug}`)}>{p[lang].title}</a></h3>
              <span class:list={["status", p.status]}><i></i>{t.projects.status[p.status]}</span>
            </div>
            <p class="muted">{p[lang].tagline}</p>
            <div class="pcard-foot">
              <div class="chips">{p.tags.slice(0, 4).map((tg) => <span class="chip">{tg}</span>)}</div>
              {p.repo && <a class="repo-link mono" href={p.repo} rel="noopener" target="_blank">GitHub ↗</a>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-sec">
      <h2 class="label">{c.edu}</h2>
      <div class="stack">
        {education.map((e) => (
          <div class="card row" data-notilt>
            <div class="when mono" set:html={todo(e.when[lang])} />
            <div class="row-main">
              <h3>{e.degree[lang]}</h3>
              <p class="muted" set:html={todo(e.school)} />
              {e.note && <p class="note">{e.note[lang]}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="cols">
      <section class="cv-sec">
        <h2 class="label">{c.skills}</h2>
        <div class="stack">
          {skills[lang].map((g) => (
            <div class="card sk-card" data-notilt>
              <h3>{g.h}</h3>
              <div class="chips">{g.items.map((x) => <span class="chip">{x}</span>)}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="side-stack">
        <section class="cv-sec">
          <h2 class="label">{c.langs}</h2>
          <div class="card" data-notilt>
            <div class="lang-list">
              {languages.map((l) => (
                <div class="lang-row">
                  <strong>{l.name[lang]}</strong>
                  <span class="mono muted" set:html={todo(l.level[lang])} />
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="cv-sec">
          <h2 class="label">{c.certs}</h2>
          <div class="card cert-list" data-notilt>
            {certifications.map((x) => (
              <div class="cert-item">
                <strong>{x.name}</strong>
                <span class="mono cert-tag">{x.target ? c.planned : c.inProgress}</span>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  .cv { padding-block: 36px 96px; display: grid; gap: 44px; max-width: 1040px; }
  .cv-hero {
    display: flex; justify-content: space-between; gap: 28px; flex-wrap: wrap; align-items: center;
    padding: clamp(24px, 4vw, 38px); border-top: 3px solid var(--accent);
  }
  .cv-id { display: grid; gap: 10px; max-width: 700px; }
  .cv-id .label { display: inline-flex; align-items: center; gap: 8px; color: var(--accent); }
  h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.05; }
  .role { font-size: clamp(17px, 2vw, 20px); font-weight: 600; color: var(--fg); }
  .role span { color: var(--muted); font-weight: 400; }
  .contact { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-top: 6px; font-size: 12.5px; color: var(--muted); direction: ltr; justify-content: flex-start; }
  :root[dir="rtl"] .contact { justify-content: flex-end; }
  .contact a { color: var(--accent); text-decoration: none; }
  .contact a:hover { text-decoration: underline; }
  .dl-btn { height: 50px; padding-inline: 24px; font-size: 15px; white-space: nowrap; }

  .cv-sec { display: grid; gap: 16px; }
  .cv-sec > .label { margin: 0; color: var(--accent); }
  .stack { display: grid; gap: 14px; }

  .summary-card { display: grid; gap: 12px; }
  .summary-lead { font: 600 18px/1.4 var(--f-display); color: var(--fg); }
  .summary-body { display: grid; gap: 10px; color: var(--muted); font-size: 15px; }

  .row { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; align-items: start; }
  .when { color: var(--accent); font-size: 12.5px; padding-top: 4px; }
  .row-main { display: grid; gap: 6px; }
  h3 { font-size: 18px; }
  .at { color: var(--muted); font-weight: 500; }
  .place { font-size: 14px; }
  .note { font-size: 14.5px; color: var(--fg); margin-top: 4px; }
  ul { margin: 8px 0 0; padding-inline-start: 18px; display: grid; gap: 8px; color: var(--fg); font-size: 15px; }
  ul li::marker { color: var(--accent); }

  .proj-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .pcard { display: flex; flex-direction: column; gap: 10px; padding: 20px; }
  .pcard-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pcard h3 { font-size: 17px; }
  .pcard h3 a { text-decoration: none; }
  .pcard h3 a:hover { color: var(--accent); }
  .pcard p { font-size: 14px; line-height: 1.55; }
  .pcard-foot { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .repo-link { font-size: 12px; color: var(--ai); text-decoration: none; }
  .repo-link:hover { text-decoration: underline; }

  .cols { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .side-stack { display: grid; gap: 28px; }
  .sk-card { padding: 18px 20px; display: grid; gap: 10px; }
  .sk-card h3 { font-size: 15.5px; }
  .sk-card .chip { color: var(--fg); background: var(--panel-2); }

  .lang-list, .cert-list { display: grid; gap: 12px; }
  .lang-row { display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px dashed var(--line); }
  .lang-row:last-child { padding-bottom: 0; border-bottom: 0; }
  .cert-item { display: grid; gap: 4px; padding-bottom: 12px; border-bottom: 1px dashed var(--line); }
  .cert-item:last-child { padding-bottom: 0; border-bottom: 0; }
  .cert-item strong { font-size: 14.5px; line-height: 1.4; }
  .cert-tag { font-size: 11.5px; color: var(--ai); }

  @media (max-width: 820px) {
    .row, .proj-grid, .cols { grid-template-columns: 1fr; }
    .row { gap: 6px; }
  }
  @media print {
    .cv { padding: 0; gap: 18px; }
    .card, .tile { box-shadow: none !important; border: 1px solid #ccc !important; padding: 12px !important; }
    a { color: inherit !important; }
  }
</style>
